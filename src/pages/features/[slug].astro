---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import { url } from '@/lib/url';
import { getFeatureShots } from '@/lib/screenshots';
import { config } from '@/config';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import Badges from '@/components/Badges.astro';
import Screenshot from '@/components/Screenshot.astro';
import CopyButton from '@/components/CopyButton.astro';

export async function getStaticPaths() {
  const features = await getCollection('features');
  const bySlug = new Map(features.map((f) => [f.data.slug, f]));
  return features.map((entry) => ({
    params: { slug: entry.data.slug },
    props: {
      entry,
      related: (entry.data.related ?? []).map((s) => bySlug.get(s)).filter((x): x is CollectionEntry<'features'> => !!x),
    },
  }));
}

interface Props {
  entry: CollectionEntry<'features'>;
  related: CollectionEntry<'features'>[];
}
const { entry, related } = Astro.props;
const f = entry.data;
const { Content } = await render(entry);
const shots = getFeatureShots(f.slug);
// Social card: the first screenshot (light), as a JPEG.
const og = shots[0] ? (await getImage({ src: shots[0].light, width: 720, format: 'jpg' })).src : undefined;

const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

const stepIcon = (s: string) => {
  const t = s.toLowerCase();
  if (t.includes('home tab')) return 'home';
  if (t.includes('more tab')) return 'grid_view';
  if (t.includes('history tab')) return 'receipt';
  if (t.includes('analytics tab')) return 'insert_chart';
  if (t.includes('search')) return 'search';
  if (t.includes('setting')) return 'settings';
  if (t.includes('+') || t.includes('add button')) return 'add';
  if (t.includes('widget')) return 'widgets';
  return null;
};
const promo = config.currentPromo;
const routes = f.navigation ?? [];
---
<BaseLayout title={f.title} description={f.description} ogImage={og} ogType="article">
  <!-- Feature page template (design: Web v1 Feature Pages, SMS Import P2). -->
  <div class="wrap fwrap">
    <nav aria-label="Breadcrumb" class="crumbs t-label">
      <a href={url('/features')}>Features</a><Icon name="chevron_right" size={18} /><span aria-current="page">{f.title}</span>
    </nav>
    <header class="head">
      <span class="tile big"><Icon name={f.iconName ?? 'apps'} size={32} /></span>
      <div class="head-text">
        <div class="title"><h1 class="t-headline">{f.title}</h1><Badges signature={f.signature} /></div>
        <p class="t-lead">{f.description}</p>
      </div>
    </header>
    {routes.length > 0 && (
      <div class="wtf-row">
        <button type="button" class="wtf-btn sl" aria-haspopup="dialog" data-dialog-open="where">
          <Icon name="explore" size={18} />
          <span class="t-label">Where to find in app</span>
          <span class="wtf-count t-cap">{routes.length} {routes.length === 1 ? 'way' : 'ways'}</span>
        </button>
      </div>
    )}

    {shots.length > 0 && (
      <section aria-label={`${f.title} screenshots`} class="shots-wrap">
        <div class="shots" style={`--n:${shots.length}`}>
          {shots.map((s, i) => <Screenshot shot={s} width={238} eager={i === 0} alt={`${f.title} screenshot: ${s.alt}`} />)}
        </div>
      </section>
    )}

    <div class="body">
      <article class="article">
        <div class="prose"><Content /></div>

        {promo && (
          <div class="card promo">
            <h2 class="t-title-m">Try Pro free</h2>
            <p class="muted">{promo.description}</p>
            <div class="code"><code class="t-title-s">{promo.code}</code><CopyButton text={promo.code} label="Copy code" /></div>
          </div>
        )}

        <div class="foot">
          <a href={config.playStoreUrl} target="_blank" rel="noopener" class="btn btn-filled btn-l has-trail sl">Try it in Kuber<Icon name="arrow_forward" size={20} /></a>
          <a href={url('/docs/privacy-policy')} class="link muted">Read the privacy details</a>
        </div>
      </article>

      <aside class="aside">
        {related.length > 0 && (
          <div class="related">
            <div class="eyebrow muted">Related features</div>
            {related.map((r) => (
              <a href={url(`/features/${r.data.slug}`)} class="rel sl">
                <span class="tile"><Icon name={r.data.iconName ?? 'apps'} size={22} /></span>
                <span class="rel-text"><span class="t-title-s">{r.data.title}</span></span>
                <Icon name="chevron_right" size={20} class="muted" />
              </a>
            ))}
          </div>
        )}
      </aside>
    </div>
  </div>

  {routes.length > 0 && (
    <dialog class="wtf" id="where" aria-labelledby="where-title">
      <div class="wtf-head">
        <div class="wtf-intro">
          <span class="eyebrow wtf-eyebrow"><Icon name="explore" size={16} />App navigation</span>
          <h2 id="where-title" class="t-title-l">Where to find {f.title}</h2>
          <p class="t-body-s muted">Follow any of these navigation paths inside the Kuber Android app:</p>
        </div>
        <button type="button" class="ibtn sl" aria-label="Close navigation guide" data-dialog-close><Icon name="close" size={22} /></button>
      </div>
      <div class="wtf-list">
        {routes.map((r, i) => (
          <div class="route">
            <div class="route-head"><span class="eyebrow muted">Option {i + 1}</span><span class="t-title-s">{r.title}</span></div>
            <ol class="steps" aria-label={r.title}>
              {r.steps.map((st, j) => (
                <li>
                  {j > 0 && <Icon name="chevron_right" size={18} class="muted" />}
                  <span class="step t-label">{stepIcon(st) && <Icon name={stepIcon(st)!} size={18} class="step-ic" />}{st}</span>
                </li>
              ))}
            </ol>
            {r.note && <div class="note t-cap muted"><span class="dot"></span>{cap(r.note)}</div>}
          </div>
        ))}
      </div>
    </dialog>
  )}
</BaseLayout>

<style>
  .fwrap {
    max-width: calc(1000px + 2 * var(--k-gutter));
    padding-top: 128px;
  }
  .crumbs {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    padding-top: 32px;
    color: var(--k-on-surface-variant);
  }
  .crumbs a {
    color: var(--k-on-surface-variant);
    text-decoration: none;
  }
  .crumbs [aria-current] {
    color: var(--k-on-surface);
  }
  .head {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    padding: 24px 0 8px;
  }
  .big {
    width: 64px;
    height: 64px;
    border-radius: 18px;
  }
  .head-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .title {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .head .t-lead {
    max-width: 560px;
  }
  .wtf-row {
    padding-top: 12px;
  }
  .shots-wrap {
    padding: 32px 0;
  }
  .shots {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 238px));
    gap: 20px;
    justify-content: center;
    align-items: start;
  }
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 48px;
    padding: 16px 0 var(--k-section);
  }
  .article {
    display: flex;
    flex-direction: column;
    gap: 32px;
    min-width: 0;
  }
  .wtf-btn {
    height: 40px;
    padding: 0 8px 0 12px;
    border-radius: var(--k-r-full);
    border: 1px solid var(--k-outline-variant);
    background: var(--k-surface-container-low);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--k-on-surface);
  }
  .wtf-btn :global(.ic) {
    color: var(--k-primary);
  }
  .wtf-count {
    height: 24px;
    padding: 0 8px;
    border-radius: var(--k-r-full);
    background: var(--k-secondary-container);
    color: var(--k-on-secondary-container);
    display: inline-flex;
    align-items: center;
    font-weight: 600;
  }
  .wtf {
    width: min(560px, calc(100vw - 32px));
    max-height: calc(100dvh - 48px);
    border: 1px solid var(--k-outline-variant);
    border-radius: 28px;
    padding: 28px;
    background: var(--k-surface-container);
    color: var(--k-on-surface);
  }
  .wtf[open] {
    display: flex;
    flex-direction: column;
    gap: 20px;
    animation: wtf-in var(--k-dur-fast) var(--k-ease);
  }
  .wtf::backdrop {
    background: color-mix(in srgb, var(--k-scrim) 100%, transparent);
  }
  @keyframes wtf-in {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }
  .wtf-head {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }
  .wtf-intro {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .wtf-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .ibtn {
    width: 40px;
    height: 40px;
    border-radius: var(--k-r-full);
    background: var(--k-surface-container-high);
    color: var(--k-on-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }
  .wtf-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .route {
    padding: 16px;
    border-radius: var(--k-r-l);
    background: var(--k-surface-container-low);
    border: 1px solid var(--k-outline-variant);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .route-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }
  .note {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--k-warning);
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .steps li {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .step :global(.step-ic) {
    color: var(--k-primary);
  }
  .step {
    min-height: 32px;
    padding: 4px 12px;
    border-radius: var(--k-r-xs);
    background: var(--k-surface-container-high);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .promo {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 16px;
  }
  .code {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .code code {
    font-family: var(--k-mono);
    letter-spacing: 1px;
  }
  .foot {
    display: flex;
    gap: 12px 20px;
    flex-wrap: wrap;
    align-items: center;
    padding-top: 24px;
    border-top: 1px solid var(--k-outline-variant);
  }
  .aside {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .related {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .rel {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    border-radius: var(--k-r-m);
    background: var(--k-surface-container-low);
    border: 1px solid var(--k-outline-variant);
    color: var(--k-on-surface);
    text-decoration: none;
  }
  .rel-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    align-items: flex-start;
  }
  @media (max-width: 1023px) {
    .body {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .shots {
      grid-template-columns: repeat(var(--n), 220px);
      justify-content: start;
      overflow-x: auto;
      padding-bottom: 8px;
      scroll-snap-type: x proximity;
    }
    .shots :global(.shot) {
      scroll-snap-align: start;
    }
  }
  @media (max-width: 599px) {
    .shots-wrap {
      margin: 0 calc(-1 * var(--k-gutter));
      padding: 32px var(--k-gutter) 8px;
    }
    .shots {
      gap: 12px;
    }
    .body {
      padding-top: 16px;
      gap: 40px;
    }
    .fwrap {
      padding-top: 96px;
    }
    .crumbs {
      padding-top: 16px;
    }
    .big {
      width: 56px;
      height: 56px;
    }
  }
</style>
