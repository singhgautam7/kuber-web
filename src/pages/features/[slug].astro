---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import { url } from '@/lib/url';
import { getFeatureShots } from '@/lib/screenshots';
import { config } from '@/config';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import Badges from '@/components/Badges.astro';
import PlayBadge from '@/components/PlayBadge.astro';
import Screenshot from '@/components/Screenshot.astro';
import CopyButton from '@/components/CopyButton.astro';

export async function getStaticPaths() {
  const features = await getCollection('features');
  const bySlug = new Map(features.map((f) => [f.data.slug, f]));
  return features.map((entry) => ({
    params: { slug: entry.data.slug },
    props: {
      entry,
      related: (entry.data.related ?? []).map((s) => bySlug.get(s)).filter((x): x is CollectionEntry<'features'> => !!x),
    },
  }));
}

interface Props {
  entry: CollectionEntry<'features'>;
  related: CollectionEntry<'features'>[];
}
const { entry, related } = Astro.props;
const f = entry.data;
const { Content } = await render(entry);
const shots = getFeatureShots(f.slug);
// Social card: the first screenshot (light), as a JPEG.
const og = shots[0] ? (await getImage({ src: shots[0].light, width: 720, format: 'jpg' })).src : undefined;

// Plan card rows (Web v1 F2).
const [freeLine, proLine] = (f.limit ?? '').split(/\.\s*/).map((s) => s.replace(/^(Free|Pro):\s*/, ''));
const planRows: [string, string][] =
  f.plan === 'both' ? [['free', freeLine], ['pro', proLine]]
  : f.plan === 'pro' ? [['pro', 'Included'], ['free', f.limit ?? 'Not included']]
  : f.plan === 'free' ? [['free', 'Included']]
  : [];
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

const stepIcon = (s: string) => {
  const t = s.toLowerCase();
  if (t.includes('home tab')) return 'home';
  if (t.includes('more tab')) return 'grid_view';
  if (t.includes('history tab')) return 'receipt';
  if (t.includes('analytics tab')) return 'insert_chart';
  if (t.includes('search')) return 'search';
  if (t.includes('setting')) return 'settings';
  if (t.includes('+') || t.includes('add button')) return 'add';
  if (t.includes('widget')) return 'widgets';
  return null;
};
const promo = config.currentPromo;
---
<BaseLayout title={f.title} description={f.description} ogImage={og} ogType="article">
  <div class="wrap">
    <div class="page-top top">
      <div class="head">
        <nav aria-label="Breadcrumb" class="crumbs t-body-s">
          <a href={url('/features')}>Features</a><Icon name="chevron_right" size={18} /><span aria-current="page">{f.title}</span>
        </nav>
        <span class="tile tile-pc big"><Icon name={f.iconName ?? 'apps'} size={32} /></span>
        <div class="title">
          <h1 class="t-display">{f.title}</h1>
          <Badges plan={f.plan} beta={f.beta} />
        </div>
        <p class="t-lead">{f.description}</p>
        <div class="actions">
          <PlayBadge />
          <a href={url('/features')} class="btn btn-text btn-l has-trail sl">All features<Icon name="arrow_forward" size={20} /></a>
        </div>
      </div>
    </div>

    {shots.length > 0 && (
      <section aria-label={`${f.title} screenshots`} class="shots-wrap">
        <div class="shots" style={`--n:${shots.length}`}>
          {shots.map((s, i) => <Screenshot shot={s} width={238} eager={i === 0} alt={`${f.title} screenshot: ${s.alt}`} />)}
        </div>
      </section>
    )}

    <div class="body">
      <article class="article">
        <h2 class="t-title-l">How it works</h2>
        <div class="prose"><Content /></div>

        {f.navigation && f.navigation.length > 0 && (
          <>
            <h2 class="t-title-l where">Where to find it in the app</h2>
            <div class="routes">
              {f.navigation.map((r) => (
                <div class="route">
                  <div class="route-head"><span class="t-title-s">{r.title}</span>{r.note && <span class="t-cap muted">{cap(r.note)}</span>}</div>
                  <ol class="steps" aria-label={r.title}>
                    {r.steps.map((s, j) => (
                      <li>
                        {j > 0 && <Icon name="chevron_right" size={18} class="muted" />}
                        <span class="step t-label">{stepIcon(s) && <Icon name={stepIcon(s)!} size={16} />}{s}</span>
                      </li>
                    ))}
                  </ol>
                </div>
              ))}
            </div>
          </>
        )}

        {promo && (
          <div class="card promo">
            <h2 class="t-title-m">Try Pro free</h2>
            <p class="muted">{promo.description}</p>
            <div class="code"><code class="t-title-s">{promo.code}</code><CopyButton text={promo.code} label="Copy code" /></div>
          </div>
        )}

        <div class="foot">
          <a href={url('/docs/privacy-policy')} class="link"><Icon name="shield" size={18} />Read the privacy details</a>
        </div>
      </article>

      <aside class="aside">
        {planRows.length > 0 && (
          <div class="card plan">
            <div class="eyebrow muted">Plan</div>
            {planRows.map(([k, v]) => (
              <div class="plan-row"><Badges plan={k as 'free' | 'pro'} /><span class="t-label">{cap(v)}</span></div>
            ))}
            <a href={url('/features/pro-plans')} class="link">Compare Free and Pro<Icon name="arrow_forward" size={18} /></a>
          </div>
        )}
        {related.length > 0 && (
          <div class="related">
            <div class="eyebrow muted">Related features</div>
            {related.map((r) => (
              <a href={url(`/features/${r.data.slug}`)} class="rel sl">
                <span class="tile"><Icon name={r.data.iconName ?? 'apps'} size={22} /></span>
                <span class="rel-text"><span class="t-title-s">{r.data.title}</span><Badges plan={r.data.plan} beta={r.data.beta} /></span>
                <Icon name="chevron_right" size={20} class="muted" />
              </a>
            ))}
          </div>
        )}
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .head {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 760px;
  }
  .crumbs {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    color: var(--k-on-surface-variant);
  }
  .crumbs a {
    color: var(--k-on-surface-variant);
  }
  .crumbs [aria-current] {
    color: var(--k-on-surface);
  }
  .big {
    width: 64px;
    height: 64px;
    border-radius: 20px;
  }
  .title {
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: flex-start;
  }
  .actions {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 8px;
  }
  .shots-wrap {
    padding: 48px 0 16px;
  }
  .shots {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 238px));
    gap: 20px;
    justify-content: center;
    align-items: start;
  }
  .body {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: 72px;
    padding: 72px 0 var(--k-section);
  }
  .article {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 680px;
    min-width: 0;
  }
  .where {
    margin-top: 24px;
  }
  .routes {
    background: var(--k-surface-container-low);
    border: 1px solid var(--k-outline-variant);
    border-radius: var(--k-r-l);
    overflow: hidden;
  }
  .route {
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .route + .route {
    border-top: 1px solid var(--k-outline-variant);
  }
  .route-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .steps li {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .step {
    min-height: 32px;
    padding: 4px 12px;
    border-radius: var(--k-r-xs);
    background: var(--k-surface-container-high);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .promo {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 16px;
  }
  .code {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .code code {
    font-family: var(--k-mono);
    letter-spacing: 1px;
  }
  .foot {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    padding-top: 16px;
    border-top: 1px solid var(--k-outline-variant);
    margin-top: 12px;
  }
  .aside {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .plan {
    border-radius: var(--k-r-l);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .plan-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .plan-row .t-label {
    text-align: right;
  }
  .related {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .rel {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    border-radius: var(--k-r-m);
    background: var(--k-surface-container-low);
    border: 1px solid var(--k-outline-variant);
    color: var(--k-on-surface);
    text-decoration: none;
  }
  .rel-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    align-items: flex-start;
  }
  @media (max-width: 1023px) {
    .body {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .shots {
      grid-template-columns: repeat(var(--n), 220px);
      justify-content: start;
      overflow-x: auto;
      padding-bottom: 8px;
      scroll-snap-type: x proximity;
    }
    .shots :global(.shot) {
      scroll-snap-align: start;
    }
  }
  @media (max-width: 599px) {
    .shots-wrap {
      margin: 0 calc(-1 * var(--k-gutter));
      padding: 32px var(--k-gutter) 8px;
    }
    .shots {
      gap: 12px;
    }
    .body {
      padding-top: 48px;
      gap: 40px;
    }
  }
</style>
