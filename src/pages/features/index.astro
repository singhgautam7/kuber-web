---
import { getCollection } from 'astro:content';
import { FEATURE_CATEGORIES } from '@/content.config';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import FeatureCard from '@/components/FeatureCard.astro';

const features = (await getCollection('features')).map((f) => f.data).sort((a, b) => a.order - b.order);
// Counts come from the data. Chips: All and Signature (design review round 2).
const chips = [
  ['all', 'All', features.length],
  ['signature', 'Signature', features.filter((f) => f.signature).length],
] as const;
const groups = FEATURE_CATEGORIES.map((c) => ({ c, id: c.toLowerCase().replace(/[^a-z]+/g, '-'), items: features.filter((f) => f.category === c) }));
const intro = 'A complete picture of what Kuber does. Free features are yours forever. Pro unlocks the rest. Everything runs offline.';
---
<BaseLayout title="Features" description={intro}>
  <div class="wrap">
    <header class="page-top head">
      <div class="shead">
        <div class="eyebrow">Features</div>
        <h1 class="t-display">Every tool, one app</h1>
        <p class="t-lead">{intro}</p>
      </div>
      <div class="chips" role="group" aria-label="Filter features" data-filter-chips>
        {chips.map(([id, label, n], i) => (
          <button type="button" class="fchip sl" data-filter={id} aria-pressed={i === 0 ? 'true' : 'false'}>
            <Icon name="check" size={18} class="fchip-check" />
            <span class="t-label">{label}</span><span class="t-cap">{n}</span>
          </button>
        ))}
      </div>
    </header>
    <div class="groups">
      {groups.map(({ c, id, items }) => (
        <section aria-labelledby={`cat-${id}`} data-feature-group>
          <div class="g-head"><h2 id={`cat-${id}`} class="t-title-l">{c}</h2><span class="t-body-s muted">{items.length}</span></div>
          <div class="grid">{items.map((f) => <FeatureCard feature={f} />)}</div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .head {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 8px;
  }
  .fchip {
    height: 36px;
    padding: 0 14px;
    border-radius: var(--k-r-full);
    border: 1px solid var(--k-outline-variant);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--k-on-surface-variant);
  }
  .fchip :global(.fchip-check) {
    display: none;
  }
  .fchip[aria-pressed='true'] {
    background: var(--k-secondary-container);
    border-color: var(--k-secondary-container);
    color: var(--k-on-secondary-container);
    padding-left: 10px;
    --sl: var(--k-on-secondary-container);
  }
  .fchip[aria-pressed='true'] :global(.fchip-check) {
    display: inline-block;
  }
  .groups {
    display: flex;
    flex-direction: column;
    gap: 72px;
    padding: 64px 0 var(--k-section);
  }
  .groups section {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .groups section[hidden] {
    display: none;
  }
  .g-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  @media (max-width: 1023px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 599px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .groups {
      gap: 48px;
      padding-top: 40px;
    }
  }
</style>
