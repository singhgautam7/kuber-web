---
import { getEntry, render } from 'astro:content';
import { config } from '@/config';
import { obfuscateEmail } from '@/lib/obfuscate-email';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import CopyButton from '@/components/CopyButton.astro';

const about = await getEntry('pages', 'about');
const { Content } = await render(about!);
const email = obfuscateEmail(config.developerEmail);

// Renamed from "Why Kuber" so it doesn't clash with the in-app Why Kuber tour.
const principles = [
  ['bolt', 'Fast transaction entry', 'Log expenses in under 3 seconds.'],
  ['dashboard', 'Minimal design', 'Focus on your data, not the interface.'],
  ['wifi_off', 'Works offline', 'Full functionality without an active connection.'],
  ['event_repeat', 'Built for consistency', 'Reliable tools for long-term habits.'],
];
---
<BaseLayout title="About" description="A letter from the developer of Kuber, and what the app is about." ogType="article">
  <div class="wrap wrap-narrow">
    <article class="page-top">
      <div class="card letter">
        <div class="eyebrow">A note from the maker</div>
        <h1 class="t-display">A letter from the developer</h1>
        <div class="letter-body"><Content /></div>
        <a href={config.portfolioUrl} target="_blank" rel="noopener" class="sign sl">
          <span class="avatar" aria-hidden="true">GS</span>
          <span class="sign-text"><span class="t-cap muted">Signed</span><span class="t-title-m">Gautam</span></span>
          <span class="mono t-cap muted">singhgautam.com</span>
          <Icon name="north_east" size={20} class="muted" />
        </a>
      </div>
    </article>

    <section class="block" aria-labelledby="principles">
      <h2 id="principles" class="eyebrow">Built for everyday use</h2>
      <div class="grid2">
        {principles.map(([icon, t, s]) => (
          <div class="card">
            <span class="tile"><Icon name={icon} size={22} /></span>
            <div class="t-title-m p-title">{t}</div>
            <div class="t-body-s muted">{s}</div>
          </div>
        ))}
      </div>
    </section>

    <section class="block" aria-labelledby="what">
      <h2 id="what" class="eyebrow">What is Kuber</h2>
      <p class="t-title-l">A simple way to <span class="accent">stay aware</span> of where your money goes.</p>
      <p class="t-lead">Kuber is a fast, no-fuss expense tracker. Built for consistency, not complexity. Open it, log what you spent, move on.</p>
      <ul class="tags">{['Fast', 'Offline', 'Private', 'Habit-friendly'].map((t) => <li class="chip">{t}</li>)}</ul>
    </section>

    <section class="block meaning" aria-labelledby="meaning">
      <h2 id="meaning" class="eyebrow">What does 'Kuber' mean · Sanskrit</h2>
      <p class="t-lead">In Indian mythology, Kuber is the guardian of wealth and prosperity. He represents not just riches, but the responsibility of managing wealth wisely.</p>
      <p class="t-title-l quote">Kuber is not about having more. It's about being aware of what you have.</p>
    </section>

    <section class="block contact" aria-label="Contact">
      <div class="grid2">
        <a href={config.githubUrl} target="_blank" rel="noopener" class="card c-card sl">
          <span class="eyebrow muted">Source</span>
          <span class="t-title-m">GitHub</span>
          <span class="mono t-body-s muted">github.com/singhgautam7/Kuber</span>
        </a>
        <div class="card c-card" data-email-box>
          <span class="eyebrow muted">Contact</span>
          <span class="t-title-m">Email the developer</span>
          <button type="button" class="reveal link" data-reveal-email={email.encoded}><Icon name="mail" size={18} />Tap to reveal email</button>
          <div class="revealed">
            <a href="#" class="link mono" data-email-link><Icon name="mail" size={18} /><span>{email.masked}</span></a>
            <CopyButton text="" label="Copy email" kind="tonal" attrs={{ 'data-email-copy': '' }} />
          </div>
        </div>
      </div>
      <p class="t-body-s muted made">Made in India by {config.developerName}</p>
    </section>
  </div>
</BaseLayout>

<style>
  .letter {
    border-radius: var(--k-r-3xl);
    padding: 56px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .letter-body {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-top: 12px;
  }
  .letter-body :global(p) {
    font: 400 17px/30px var(--k-font);
    text-wrap: pretty;
  }
  .letter-body :global(p:first-child) {
    font-weight: 600;
  }
  .sign {
    margin-top: 12px;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    border-radius: var(--k-r-l);
    background: var(--k-surface-container);
    border: 1px solid var(--k-outline-variant);
    color: var(--k-on-surface);
    text-decoration: none;
  }
  .avatar {
    width: 48px;
    height: 48px;
    border-radius: 999px;
    background: var(--k-primary-container);
    color: var(--k-on-primary-container);
    display: flex;
    align-items: center;
    justify-content: center;
    font: 700 17px/1 var(--k-font);
    flex: none;
  }
  .sign-text {
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .mono {
    font-family: var(--k-mono);
  }
  .block {
    padding-top: 88px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .grid2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .p-title {
    margin-top: 16px;
  }
  .accent {
    color: var(--k-primary);
  }
  .tags {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .meaning {
    margin-top: 88px;
    padding: 48px 56px;
    border-radius: var(--k-r-3xl);
    background: var(--k-secondary-container);
    color: var(--k-on-secondary-container);
    align-items: center;
    text-align: center;
  }
  .meaning .eyebrow,
  .meaning .t-lead {
    color: var(--k-on-secondary-container);
  }
  .meaning .t-lead {
    max-width: 560px;
  }
  .quote {
    margin-top: 8px;
    max-width: 560px;
    font-style: italic;
    font-weight: 600;
  }
  .contact {
    padding-bottom: var(--k-section);
  }
  .c-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: flex-start;
    color: var(--k-on-surface);
    text-decoration: none;
  }
  .reveal {
    margin-top: 4px;
  }
  .revealed {
    display: none;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    margin-top: 4px;
  }
  [data-revealed] .reveal {
    display: none;
  }
  [data-revealed] .revealed {
    display: flex;
  }
  .made {
    text-align: center;
    margin-top: 16px;
  }
  @media (max-width: 599px) {
    .letter {
      padding: 32px 24px;
      border-radius: 28px;
    }
    .grid2 {
      grid-template-columns: 1fr;
    }
    .block {
      padding-top: 56px;
    }
    .meaning {
      margin-top: 56px;
      padding: 32px 24px;
      border-radius: 28px;
    }
    .sign .mono {
      display: none;
    }
  }
</style>
