---
import { url } from '@/lib/url';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
---
<BaseLayout title="Page not found" description="The page you wanted is not here, but everything else still is.">
  <div class="nf wrap">
    <div class="inner">
      <span class="chip"><span class="dot"></span>Page not found</span>
      <div class="code tnum" aria-hidden="true">404</div>
      <h1 class="t-headline">This page went offline for good</h1>
      <p class="t-lead">Fitting for an offline app. The page you wanted is not here, but everything else still is.</p>
      <div class="actions">
        <a href={url('/')} class="btn btn-filled btn-l has-icon sl"><Icon name="home" size={20} />Back to home</a>
        <a href={url('/features')} class="btn btn-outlined btn-l sl">Browse features</a>
      </div>
      <div class="more">
        <a href={url('/docs')} class="btn btn-text btn-s sl">Docs</a>
        <a href={url('/press')} class="btn btn-text btn-s sl">Press</a>
        <a href={url('/about')} class="btn btn-text btn-s sl">About</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .nf {
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 128px;
    padding-bottom: 64px;
  }
  .inner {
    max-width: 560px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
  }
  .chip {
    padding: 0 14px 0 10px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--k-expense);
  }
  .code {
    font: 800 clamp(120px, 12vw, 200px) / 1 var(--k-font);
    letter-spacing: -6px;
    color: var(--k-primary);
  }
  .actions,
  .more {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 8px;
  }
  .more {
    gap: 4px;
  }
</style>
