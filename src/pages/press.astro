---
import { getEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { config } from '@/config';
import { asset, url } from '@/lib/url';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import BrandMark from '@/components/BrandMark.astro';
import Screenshot from '@/components/Screenshot.astro';
import CopyButton from '@/components/CopyButton.astro';

// Boilerplate lives in content/pages/press-kit.md (two paragraphs).
const press = await getEntry('pages', 'press-kit');
const [boilerplate, short] = press!.body!.trim().split(/\n\s*\n/).map((p) => p.trim());

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/screenshots/press/*.png', { eager: true });
const img = (name: string) => files[`/src/assets/screenshots/press/${name}.png`].default;
const shots = [
  ['home', 'Home'],
  ['more', 'Spaces'],
  ['add', 'Add transaction'],
  ['settings', 'Settings'],
].map(([id, name]) => ({ id, name, shot: { base: id, alt: `Kuber ${name} screen`, light: img(`${id}-light`), dark: img(`${id}-dark`) } }));

const facts = [
  ['App name', 'Kuber'],
  ['Category', 'Personal finance'],
  ['Platform', 'Android'],
  ['App size', 'Under 17 MB'],
  ['Price', 'Free, with optional Pro'],
  ['Developer', config.developerName],
];
const factText = facts.map(([k, v]) => `${k}: ${v}`).join('\n');
const wordmarks = [
  ['SVG, light', '/press/kuber-wordmark-light.svg'],
  ['SVG, dark', '/press/kuber-wordmark-dark.svg'],
  ['PNG, light', '/press/kuber-wordmark-light.png'],
  ['PNG, dark', '/press/kuber-wordmark-dark.png'],
];
---
<BaseLayout title="Press Kit" description="Logos, screenshots, boilerplate and the facts. Free to use in articles, videos and reviews.">
  <div class="wrap">
    <header class="page-top shead head">
      <div class="eyebrow">Press kit</div>
      <h1 class="t-display">Everything to write about Kuber</h1>
      <p class="t-lead">Logos, screenshots, boilerplate and the facts. Free to use in articles, videos and reviews. Questions welcome.</p>
    </header>

    <section class="brand-grid" aria-label="Logo and app icon">
      <div class="card big">
        <h2 class="eyebrow muted">App icon</h2>
        <img src={asset('/assets/app-icon.png')} alt="Kuber app icon" width="112" height="112" class="appicon" loading="lazy" />
        <div><div class="t-title-m">Kuber launcher icon</div><div class="t-body-s muted">PNG · 512 × 512 · Signature blue</div></div>
        <a href={asset('/assets/app-icon.png')} download="kuber-app-icon.png" class="btn btn-filled has-icon sl"><Icon name="download" size={20} />Download PNG</a>
      </div>
      <div class="card big">
        <h2 class="eyebrow muted">Wordmark</h2>
        <div class="wordmark"><BrandMark size={64} /><span>Kuber</span></div>
        <div><div class="t-title-m">Logo and wordmark</div><div class="t-body-s muted">SVG and PNG, for light and dark backgrounds.</div></div>
        <div class="dl-row">
          {wordmarks.map(([label, href]) => (
            <a href={asset(href)} download class="btn btn-outlined btn-s has-icon sl"><Icon name="download" size={18} />{label}</a>
          ))}
        </div>
      </div>
    </section>

    <section class="block" aria-labelledby="shots">
      <div class="block-head">
        <div><h2 id="shots" class="t-title-l">Screenshots</h2><p class="muted">PNG, light and dark, with sample data only. The previews follow the site's mode.</p></div>
      </div>
      <div class="shots">
        {shots.map((s) => (
          <figure class="shot-card">
            <Screenshot shot={s.shot} width={200} />
            <figcaption>
              <span class="t-label">{s.name}</span>
              <span class="dl">
                <a href={s.shot.light.src} download={`kuber-${s.id}-light.png`} class="t-cap">Light<Icon name="download" size={16} /></a>
                <a href={s.shot.dark.src} download={`kuber-${s.id}-dark.png`} class="t-cap">Dark<Icon name="download" size={16} /></a>
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="block">
      <div class="card big boiler">
        <div class="block-head"><h2 class="eyebrow muted">Boilerplate</h2><CopyButton text={boilerplate} /></div>
        <p class="t-lead on">{boilerplate}</p>
        <p class="muted">{short}</p>
      </div>
    </section>

    <section class="block last" aria-labelledby="facts">
      <div class="block-head"><h2 id="facts" class="t-title-l">Fact sheet</h2><CopyButton text={factText} label="Copy facts" /></div>
      <dl class="facts">
        {facts.map(([k, v]) => <div class="fact"><dt class="eyebrow muted">{k}</dt><dd class="t-title-m">{v}</dd></div>)}
      </dl>
      <p class="muted">Press questions: use the contact card on the <a href={url('/about')}>About page</a>.</p>
    </section>
  </div>
</BaseLayout>

<style>
  .head {
    max-width: 880px;
  }
  .brand-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    padding-top: 64px;
  }
  .big {
    border-radius: var(--k-r-2xl);
    padding: 32px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }
  .appicon {
    width: 112px;
    height: 112px;
    border-radius: 26px;
  }
  .wordmark {
    height: 112px;
    display: flex;
    align-items: center;
    gap: 16px;
    font: 800 48px/1 var(--k-font);
    letter-spacing: -1.4px;
  }
  .dl-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .block {
    padding-top: 72px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .last {
    padding-bottom: var(--k-section);
  }
  .block-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .block-head p {
    margin-top: 6px;
  }
  .shots {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .shot-card {
    margin: 0;
    padding: 12px;
    border-radius: var(--k-r-xl);
    background: var(--k-surface-container-low);
    border: 1px solid var(--k-outline-variant);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .shot-card :global(.shot) {
    border-radius: 18px;
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    padding: 2px 4px;
  }
  .dl {
    display: flex;
    gap: 12px;
  }
  .dl a {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    font-weight: 600;
    min-height: 24px;
  }
  .boiler {
    padding: 40px;
  }
  .on {
    color: var(--k-on-surface);
  }
  .facts {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .fact {
    padding: 20px;
    border-radius: var(--k-r-l);
    background: var(--k-surface-container-low);
    border: 1px solid var(--k-outline-variant);
  }
  .fact dd {
    margin: 8px 0 0;
  }
  @media (max-width: 1023px) {
    .shots {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 767px) {
    .brand-grid {
      grid-template-columns: 1fr;
      gap: 16px;
      padding-top: 40px;
    }
    .facts {
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
  }
  @media (max-width: 599px) {
    .big,
    .boiler {
      padding: 24px;
    }
    .wordmark {
      font-size: 40px;
      height: 88px;
    }
    .block {
      padding-top: 48px;
    }
    .shots {
      gap: 12px;
    }
    figcaption {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
