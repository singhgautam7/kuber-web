---
import { getCollection, type CollectionEntry } from 'astro:content';
import { config } from '@/config';
import { url, asset } from '@/lib/url';
import { THEMES, PALETTES } from '@/lib/theme';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PromoBanner from '@/components/PromoBanner.astro';
import HeroPhone from '@/components/HeroPhone.astro';
import ShowcasePhone from '@/components/ShowcasePhone.astro';
import FeatureCard from '@/components/FeatureCard.astro';
import FeatureIcon from '@/components/FeatureIcon.astro';
import PlayStoreBadge from '@/components/PlayStoreBadge.astro';

const features = (await getCollection('features')).sort((a, b) => a.data.order - b.data.order);
const bySlug = new Map(features.map((f) => [f.data.slug, f]));

// Curated "What Kuber does" grid: the six headline capabilities. Cards may
// override the collection's title/description for the homepage highlight.
const gridSlugs: Array<{ slug: string; title?: string; description?: string }> = [
  { slug: 'expense-tracking' },
  { slug: 'detailed-analytics', description: 'See where your money goes with category breakdowns, budget vs actual, trends and tag analytics.' },
  { slug: 'sms-import' },
  { slug: 'quick-add' },
  { slug: 'voice-input', title: 'Voice Add' },
  { slug: 'powerful-filtering' },
];
interface GridCard {
  entry: CollectionEntry<'features'>;
  title?: string;
  description?: string;
}
const gridFeatures: GridCard[] = gridSlugs.flatMap((g) => {
  const f = bySlug.get(g.slug);
  return f ? [{ entry: f, title: g.title, description: g.description }] : [];
});

const signatureFeatures = features.filter((f) => f.data.signature).slice(0, 5);

const trust = ['Offline', 'Private', 'Open Source', 'Made in India', 'Under 17 MB'];
const numbers = [
  { value: '6,000+', label: 'Transactions handled in production' },
  { value: '20+', label: 'Banks supported for SMS import' },
  { value: '5', label: 'Languages' },
  { value: '12+', label: 'Home screen widgets' },
  { value: '13', label: 'Built-in calculators' },
];
const banks = ['hdfc', 'sbi', 'icici', 'axis', 'kotak', 'pnb', 'idfc', 'yesbank'];
const testimonials = [
  { text: 'Your words here. Add a real review once the first ones come in.', name: 'Reviewer name', role: 'Play Store' },
  { text: 'A short quote from a happy user, kept honest and specific.', name: 'Reviewer name', role: 'Reddit' },
  { text: 'One more placeholder card, ready to swap for the real thing.', name: 'Reviewer name', role: 'Product Hunt' },
];
---
<BaseLayout title="Kuber" footer="full">
  <PromoBanner />

  <!-- HERO -->
  <header class="container hero" data-hero>
    <div>
      <div class="hero-pill">
        <span class="hero-pill-dot"></span>
        <span class="hero-pill-text">Local-first personal finance, made in India</span>
      </div>
      <h1 class="hero-title">Kuber</h1>
      <p class="hero-tagline">Fully offline. <span class="serif-italic hero-accent">Fully yours.</span></p>
      <p class="hero-desc">Track expenses, read your spending and stay on top of your money. No account, no cloud, no tracking. Your data never leaves your phone.</p>
      <div class="hero-cta">
        <PlayStoreBadge />
        <a href={url('/features')} class="hero-link">See all features
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </div>
    <HeroPhone />
  </header>

  <!-- TRUST ROW -->
  <div class="trust">
    <div class="container trust-inner">
      {trust.map((t) => <span class="trust-item">{t}</span>)}
    </div>
  </div>

  <!-- FEATURE GRID -->
  <section class="container section">
    <div class="eyebrow">WHAT KUBER DOES</div>
    <h2 class="section-h2 wide">Everything you need to track money, nothing you don't.</h2>
    <div class="fgrid" data-fgrid>
      {gridFeatures.map(({ entry, title, description }) => (
        <FeatureCard
          slug={entry.data.slug}
          title={title ?? entry.data.title}
          description={description ?? entry.data.description}
          iconName={entry.data.iconName}
          pro={entry.data.pro}
          beta={entry.data.beta}
          signature={entry.data.signature}
        />
      ))}
    </div>
  </section>

  <!-- SIGNATURE STRIP -->
  <section class="sig-section">
    <div class="container">
      <div class="eyebrow">SIGNATURE</div>
      <h2 class="section-h2">The features people switch for</h2>
    </div>
    <div class="sig-strip scroll-x" data-sigstrip>
      {signatureFeatures.map((s) => (
        <a href={url(`/features/${s.data.slug}`)} class="sig-card">
          <div class="sig-glow"></div>
          <div class="sig-icon"><FeatureIcon name={s.data.iconName ?? s.data.slug} size={20} /></div>
          <div class="sig-name">{s.data.title}</div>
          <div class="sig-desc">{s.data.description}</div>
          <div class="sig-more">Learn more
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- THEME SHOWCASE -->
  <section class="showcase">
    <div class="container showcase-grid" data-showcase>
      <div>
        <div class="eyebrow">MAKE IT YOURS</div>
        <h2 class="section-h2">Seven themes. Light and dark.</h2>
        <p class="showcase-p">Pick an accent family and Kuber recolors, income and expense included. Tap a theme below to try it. The whole site changes with you.</p>
        <div class="showcase-mode" role="group" aria-label="Light or dark mode">
          <span class="showcase-mode-label">MODE</span>
          <div class="showcase-mode-toggle">
            <button type="button" class="showcase-mode-btn" data-set-mode="light">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5L19 19M19 5l-1.5 1.5M6.5 17.5L5 19"/></svg>
              Light
            </button>
            <button type="button" class="showcase-mode-btn" data-set-mode="dark">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
              Dark
            </button>
          </div>
        </div>
        <div class="showcase-cards-label">ACCENT</div>
        <div class="showcase-cards">
          {THEMES.map((t) => (
            <button
              type="button"
              class="showcase-card"
              data-set-variant={t.id}
              style={`--sw-dark:${PALETTES[t.id].dark.accent};--sw-light:${PALETTES[t.id].light.accent}`}
            >
              <span class="showcase-swatch" aria-hidden="true"></span>
              <span class="showcase-card-text">
                <span class="showcase-card-name">{t.name}</span>
                <span class="showcase-card-label">{t.label}</span>
              </span>
            </button>
          ))}
        </div>
      </div>
      <ShowcasePhone />
    </div>
  </section>

  <!-- NUMBERS -->
  <section class="container section-numbers">
    <div class="numbers" data-numbers>
      {numbers.map((n) => (
        <div class="number-card">
          <div class="number-value">{n.value}</div>
          <div class="number-label">{n.label}</div>
        </div>
      ))}
    </div>
    <div class="banks">
      <span class="banks-label">Reads SMS from 20+ banks</span>
      {banks.map((b) => (
        <div class="bank"><img src={asset(`/assets/banks/${b}.svg`)} alt="" loading="lazy" /></div>
      ))}
    </div>
  </section>

  <!-- DEVELOPER STORY -->
  <section class="container section-dev">
    <div class="dev-card" data-devstory>
      <div class="dev-avatar">GS</div>
      <div>
        <div class="dev-eyebrow">MADE BY ONE DEVELOPER</div>
        <p class="dev-text">Kuber is built and maintained by {config.developerName}, one developer in India. It started because no expense app felt fast, private and simple enough for daily use. So he built one.</p>
        <div class="dev-links">
          <a href={url('/about')} class="dev-link-accent">Read the full letter<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          <a href={config.githubUrl} target="_blank" rel="noopener" class="dev-link-muted">GitHub</a>
          <a href={config.portfolioUrl} target="_blank" rel="noopener" class="dev-link-muted">singhgautam.com</a>
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="container section-testi">
    <div class="testi-head">
      <h2 class="section-h2 small">What people say</h2>
      <span class="testi-note">Real reviews coming soon</span>
    </div>
    <div class="testi-grid" data-testi>
      {testimonials.map((q) => (
        <div class="testi-card">
          <div class="testi-quote serif-italic">&ldquo;</div>
          <p class="testi-text">{q.text}</p>
          <div class="testi-person">
            <div class="testi-avatar"></div>
            <div><div class="testi-name">{q.name}</div><div class="testi-role">{q.role}</div></div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="container section-cta">
    <div class="cta-card">
      <h2 class="cta-h2">Start tracking today</h2>
      <p class="cta-p">Free to download. Under 17 MB. No account needed.</p>
      <div class="cta-badge"><PlayStoreBadge size="lg" /></div>
    </div>
  </section>
</BaseLayout>

<style>
  .eyebrow { font: 700 12px var(--font-sans); letter-spacing: 1.6px; color: var(--k-accent-text); margin-bottom: 12px; }
  .section-h2 { font-family: var(--font-sans); font-weight: 800; font-size: var(--fs-h2); letter-spacing: -0.035em; margin: 0; }
  .section-h2.wide { max-width: 640px; }
  .section-h2.small { font-size: clamp(1.6rem, 2vw, 1.9rem); letter-spacing: -0.03em; }

  .hero { padding: clamp(48px, 5vw, 80px) 22px 40px; display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(32px, 4vw, 64px); align-items: center; }
  .hero-pill { display: inline-flex; align-items: center; gap: 8px; background: var(--k-accent-subtle); border: 1px solid var(--k-accent-ring); border-radius: 999px; padding: 6px 13px; margin-bottom: 24px; }
  .hero-pill-dot { width: 7px; height: 7px; border-radius: 999px; background: var(--k-income); }
  .hero-pill-text { font: 600 12.5px var(--font-sans); color: var(--k-accent-text); }
  .hero-title { font-family: var(--font-sans); font-weight: 900; font-size: var(--fs-hero); letter-spacing: -0.042em; line-height: 0.95; margin: 0; }
  .hero-tagline { font-family: var(--font-sans); font-weight: 800; font-size: var(--fs-tagline); letter-spacing: -0.028em; margin: 16px 0 0; color: var(--k-text); }
  .hero-accent { font-weight: 700; color: var(--k-accent-text); }
  .hero-desc { font-family: var(--font-sans); font-weight: 400; font-size: var(--fs-lead); line-height: 1.6; color: var(--k-text-sec); margin: 18px 0 0; max-width: 460px; }
  .hero-cta { display: flex; align-items: center; gap: 16px; margin-top: 30px; flex-wrap: wrap; }
  .hero-link { font: 600 15px var(--font-sans); color: var(--k-text); display: inline-flex; align-items: center; gap: 6px; }

  .trust { border-top: 1px solid var(--k-border); border-bottom: 1px solid var(--k-border); }
  .trust-inner { padding: 18px 22px; display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 26px; }
  .trust-item { font: 700 12.5px var(--font-sans); letter-spacing: 1.3px; text-transform: uppercase; color: var(--k-text-sec); }

  .section { padding: 76px 22px 40px; }
  .fgrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 40px; }

  .sig-section { padding: 36px 0 40px; }
  /* Full-bleed scroller whose edges line up with the centred container, so the
     first card sits under the heading and scrollLeft:0 fully reveals it. */
  .sig-strip {
    display: flex;
    gap: 16px;
    padding: 26px max(22px, calc((100% - var(--k-maxw)) / 2 + 22px)) 12px;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scroll-padding-left: max(22px, calc((100% - var(--k-maxw)) / 2 + 22px));
  }
  .sig-card { scroll-snap-align: start; flex: 0 0 300px; background: var(--k-card); border: 1px solid var(--k-border); border-radius: 14px; padding: 24px; color: var(--k-text); position: relative; overflow: hidden; }
  .sig-glow { position: absolute; top: -30px; right: -30px; width: 120px; height: 120px; background: radial-gradient(circle, var(--k-accent-subtle), transparent 70%); }
  .sig-icon { width: 46px; height: 46px; border-radius: 11px; background: var(--k-accent); display: flex; align-items: center; justify-content: center; color: var(--k-on-accent); position: relative; }
  .sig-name { font: 800 21px var(--font-sans); letter-spacing: -0.4px; margin-top: 20px; }
  .sig-desc { font: 400 14px/1.55 var(--font-sans); color: var(--k-text-sec); margin-top: 8px; }
  .sig-more { font: 700 12.5px var(--font-sans); color: var(--k-accent-text); margin-top: 18px; display: flex; align-items: center; gap: 5px; }

  .showcase { border-top: 1px solid var(--k-border); border-bottom: 1px solid var(--k-border); background: var(--k-card); }
  .showcase-grid { padding: 70px 22px; display: grid; grid-template-columns: 1fr 0.8fr; gap: 48px; align-items: center; }
  .showcase-p { font: 400 16px/1.6 var(--font-sans); color: var(--k-text-sec); margin: 16px 0 0; max-width: 440px; }
  .showcase-mode { display: flex; align-items: center; gap: 14px; margin-top: 26px; }
  .showcase-mode-label,
  .showcase-cards-label { font: 700 11px var(--font-sans); letter-spacing: 1.4px; color: var(--k-text-sec); }
  .showcase-mode-toggle { display: inline-flex; gap: 4px; background: var(--k-bg); border: 1px solid var(--k-border); border-radius: 12px; padding: 4px; }
  .showcase-mode-btn { display: inline-flex; align-items: center; gap: 7px; padding: 8px 16px; border-radius: 9px; font: 600 13.5px var(--font-sans); color: var(--k-text-sec); background: transparent; border: 1px solid transparent; }
  /* Active mode highlight (driven by the html attribute, no JS needed). */
  :global(:root[data-mode='light']) .showcase-mode-btn[data-set-mode='light'],
  :global(:root[data-mode='dark']) .showcase-mode-btn[data-set-mode='dark'] {
    color: var(--k-accent-text);
    background: var(--k-accent-subtle);
    border-color: var(--k-accent-ring);
  }
  .showcase-cards-label { margin-top: 22px; margin-bottom: 12px; }
  .showcase-cards { display: flex; flex-wrap: wrap; gap: 11px; }
  .showcase-card { display: flex; align-items: center; gap: 11px; padding: 12px 14px; border-radius: 12px; background: var(--k-bg); border: 2px solid var(--k-border); transition: border-color 0.2s; }
  .showcase-swatch { width: 26px; height: 26px; border-radius: 8px; background: var(--sw-dark); flex-shrink: 0; }
  .showcase-card-text { display: flex; flex-direction: column; align-items: flex-start; line-height: 1.1; }
  .showcase-card-name { font: 700 14px var(--font-sans); color: var(--k-text); }
  .showcase-card-label { font: 500 11.5px var(--font-sans); color: var(--k-text-sec); margin-top: 2px; }

  .section-numbers { padding: 72px 22px 34px; }
  .numbers { display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; }
  .number-card { border: 1px solid var(--k-border); border-radius: 12px; padding: 22px 18px; background: var(--k-card); }
  .number-value { font: 800 34px var(--font-sans); letter-spacing: -1px; color: var(--k-accent-text); }
  .number-label { font: 500 13px/1.4 var(--font-sans); color: var(--k-text-sec); margin-top: 6px; }
  .banks { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 22px; margin-top: 34px; padding-top: 28px; border-top: 1px solid var(--k-border); }
  .banks-label { font: 700 11px var(--font-sans); letter-spacing: 1.3px; color: var(--k-text-sec); text-transform: uppercase; }
  .bank { height: 26px; display: flex; align-items: center; opacity: 0.85; }
  .bank img { height: 22px; width: auto; max-width: 74px; object-fit: contain; }

  .section-dev { padding: 44px 22px; }
  .dev-card { border: 1px solid var(--k-accent-ring); border-radius: 20px; padding: 40px; background: linear-gradient(180deg, var(--k-accent-subtle), transparent 55%), var(--k-card); display: grid; grid-template-columns: auto 1fr; gap: 28px; align-items: center; }
  .dev-avatar { width: 88px; height: 88px; border-radius: 999px; background: linear-gradient(135deg, var(--k-accent), color-mix(in srgb, var(--k-accent) 60%, transparent)); display: flex; align-items: center; justify-content: center; font: 800 30px var(--font-sans); color: #fff; letter-spacing: -0.5px; }
  .dev-eyebrow { font: 700 11px var(--font-sans); letter-spacing: 1.4px; color: var(--k-accent-text); }
  .dev-text { font: 500 20px/1.55 var(--font-sans); letter-spacing: -0.3px; margin: 12px 0 0; }
  .dev-links { display: flex; gap: 20px; margin-top: 18px; flex-wrap: wrap; }
  .dev-link-accent { font: 600 14px var(--font-sans); color: var(--k-accent-text); display: inline-flex; align-items: center; gap: 5px; }
  .dev-link-muted { font: 600 14px var(--font-sans); color: var(--k-text-sec); }

  .section-testi { padding: 44px 22px 20px; }
  .testi-head { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 8px; }
  .testi-note { font: 500 13px var(--font-sans); color: var(--k-text-sec); }
  .testi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 26px; }
  .testi-card { border: 1px dashed var(--k-border-muted); border-radius: 12px; padding: 24px; background: var(--k-card); }
  .testi-quote { font-weight: 700; font-size: 44px; line-height: 0.6; color: var(--k-accent-ring); }
  .testi-text { font: 400 15px/1.6 var(--font-sans); color: var(--k-text-sec); margin: 10px 0 0; }
  .testi-person { display: flex; align-items: center; gap: 10px; margin-top: 20px; }
  .testi-avatar { width: 34px; height: 34px; border-radius: 999px; background: var(--k-muted); border: 1px solid var(--k-border); }
  .testi-name { font: 600 13px var(--font-sans); color: var(--k-text); }
  .testi-role { font: 400 11.5px var(--font-sans); color: var(--k-text-sec); }

  .section-cta { padding: 40px 22px 70px; }
  .cta-card { border: 1px solid var(--k-border); border-radius: 20px; padding: clamp(40px, 4vw, 64px) 40px; text-align: center; background: radial-gradient(70% 120% at 50% 0%, var(--k-accent-subtle), transparent 60%), var(--k-card); }
  .cta-h2 { font-family: var(--font-sans); font-weight: 800; font-size: var(--fs-h2); letter-spacing: -0.035em; margin: 0; }
  .cta-p { font: 400 16px var(--font-sans); color: var(--k-text-sec); margin: 14px auto 0; max-width: 440px; }
  .cta-badge { display: flex; justify-content: center; margin-top: 26px; }

  @media (max-width: 900px) {
    .hero, .showcase-grid { grid-template-columns: 1fr; }
    .fgrid { grid-template-columns: repeat(2, 1fr); }
    .numbers { grid-template-columns: repeat(3, 1fr); }
    .testi-grid { grid-template-columns: 1fr; }
    .dev-card { grid-template-columns: 1fr; justify-items: start; }
  }
  @media (max-width: 560px) {
    .fgrid { grid-template-columns: 1fr; }
    .numbers { grid-template-columns: 1fr 1fr; }
  }
</style>
