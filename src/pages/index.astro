---
import { getCollection } from 'astro:content';
import { config } from '@/config';
import { url } from '@/lib/url';
import { getFeatureShots } from '@/lib/screenshots';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import PlayBadge from '@/components/PlayBadge.astro';
import BrandMark from '@/components/BrandMark.astro';
import Screenshot from '@/components/Screenshot.astro';
import ThemeMenu from '@/components/ThemeMenu.astro';
import Phone from '@/components/mockups/Phone.astro';
import HomeScreen from '@/components/mockups/HomeScreen.astro';
import HistoryScreen from '@/components/mockups/HistoryScreen.astro';
import WhyKuber from '@/components/home/WhyKuber.astro';
import Reviews from '@/components/home/Reviews.astro';

const features = await getCollection('features');
const bySlug = Object.fromEntries(features.map((f) => [f.data.slug, f.data]));
// Signature order from the design (H1): Ask Kuber is the wide card.
const signature = ['ask-kuber', 'sms-import', 'kuber-cards', 'kuber-notes', 'voice-input'].map((s) => bySlug[s]);

const trust = [['wifi_off', 'Offline'], ['lock', 'Private'], ['code', 'Open source'], ['flag', 'Made in India'], ['download', 'Under 17 MB']];
// Checked against the app code: sender_ids.dart, widget_catalog.dart,
// tool_catalog.dart, theme_families.dart, supported_locales.dart.
const numbers = [
  ['15', 'Banks supported for SMS import, plus UPI apps'],
  ['12', 'Home screen widgets'],
  ['18', 'Built-in calculators'],
  ['16', 'Themes, each in light and dark'],
  ['9', 'Languages'],
];
// Bank names as text, not logos (open-decisions §1).
const banks = ['HDFC Bank', 'State Bank of India', 'ICICI Bank', 'Axis Bank', 'Kotak Mahindra Bank', 'Punjab National Bank', 'IDFC FIRST Bank', 'Yes Bank'];
---
<BaseLayout title="Kuber">
  <!-- Hero and trust strip: together they fill the first screen. -->
  <div class="hero-screen" data-hero>
    <div class="wrap hero-gutter">
      <div class="panel hero">
        <div class="hero-text">
          <span class="chip status a-in" style="--d:0ms"><span class="dot"></span>Local-first personal finance, made in India</span>
          <h1 class="t-hero">
            <span class="a-in" style="--d:60ms">Fully offline.</span><br />
            <span class="a-in accent" style="--d:120ms">Fully yours.</span>
          </h1>
          <p class="t-lead a-in" style="--d:180ms">Track expenses, read your spending and stay on top of your money. No account, no cloud, no tracking. Your data never leaves your phone.</p>
          <div class="hero-actions a-in" style="--d:180ms">
            <PlayBadge />
            <a href={url('/features')} class="btn btn-text btn-l has-trail sl see-all">See all features<Icon name="arrow_forward" size={20} /></a>
          </div>
        </div>
        <div class="hero-phone a-phone">
          <Phone label="Kuber Home screen: July net plus 45,200 rupees, money stories, quick add and SMS import">
            <HomeScreen />
          </Phone>
        </div>
      </div>
    </div>
    <div class="wrap">
      <ul class="trust" aria-label="Kuber at a glance">
        {trust.map(([icon, label]) => <li class="chip"><Icon name={icon} size={18} />{label}</li>)}
      </ul>
    </div>
  </div>

  <WhyKuber />

  <!-- Signature -->
  <section class="sec" aria-labelledby="sig">
    <div class="wrap">
      <div class="shead" data-reveal>
        <div class="eyebrow">Signature</div>
        <h2 id="sig" class="t-headline">The features people switch for</h2>
      </div>
      <!-- Design H1: 3-column grid, Ask Kuber as the wide card. The whole card
           is clickable (the Learn more link stretches over it). -->
      <div class="sig-grid">
        {signature.map((f, i) => (
          <article class:list={['sig', { wide: i === 0 }]} data-reveal>
            <div class="sig-text">
              <span class="tile tile-pc sig-tile"><Icon name={f.iconName ?? 'apps'} size={24} /></span>
              <h3 class="t-title-l">{f.title}</h3>
              <p class="muted">{f.description}</p>
              {f.limit && <p class="t-body-s muted">{f.limit}</p>}
              <a href={url(`/features/${f.slug}`)} class="link sig-link">Learn more<span class="visually-hidden"> about {f.title}</span><Icon name="arrow_forward" size={18} /></a>
            </div>
            <div class="sig-img" aria-hidden="true">
              <Screenshot shot={getFeatureShots(f.slug)[0]} width={i === 0 ? 300 : 250} alt="" class="crop" />
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Themes -->
  <section class="sec" aria-labelledby="themes">
    <div class="wrap hero-gutter">
      <div class="panel themes">
        <div class="themes-text">
          <div class="shead">
            <div class="eyebrow">Make it yours</div>
            <h2 id="themes" class="t-headline">Sixteen themes. Light and dark.</h2>
            <p class="t-lead">Pick an accent family and Kuber recolors, income and expense included. Tap a theme below to try it. The whole site changes with you.</p>
          </div>
          <ThemeMenu variant="tiles" />
        </div>
        <div class="themes-phone">
          <Phone label="Kuber History screen in the selected theme">
            <HistoryScreen />
          </Phone>
        </div>
      </div>
    </div>
  </section>

  <!-- Numbers -->
  <section class="sec" aria-labelledby="numbers">
    <div class="wrap">
      <div class="shead" data-reveal>
        <div class="eyebrow">In numbers</div>
        <h2 id="numbers" class="t-headline">Small app. A lot inside.</h2>
      </div>
      <dl class="nums">
        {numbers.map(([v, l]) => (
          <div class="card num" data-reveal>
            <dt class="t-body-s muted">{l}</dt>
            <dd class="t-stat">{v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Banks -->
  <section class="banks-sec" aria-labelledby="banks">
    <div class="wrap">
      <div class="banks">
        <div class="banks-head">
          <h2 id="banks" class="t-title-m">SMS import works with 15 banks and UPI apps, including</h2>
          <a href={url('/features/sms-import')} class="link">How SMS import works<Icon name="arrow_forward" size={18} /></a>
        </div>
        <ul class="bank-list" aria-label="Supported banks">
          {banks.map((b) => <li class="chip"><Icon name="account_balance" size={18} />{b}</li>)}
          <li class="chip">and more</li>
        </ul>
        <p class="t-cap muted">Bank names are shown for reference only. Kuber is not affiliated with these banks.</p>
      </div>
    </div>
  </section>

  <!-- Developer -->
  <section class="sec" aria-labelledby="dev">
    <div class="wrap">
      <div class="card dev" data-reveal>
        <div class="avatar" aria-hidden="true">GS</div>
        <div class="dev-text">
          <h2 id="dev" class="eyebrow">Made by one developer</h2>
          <p class="dev-p">Kuber is built and maintained by {config.developerName}, a developer from India. It started because no expense app felt fast, private and simple enough for daily use. So he built one.</p>
          <div class="dev-links">
            <a href={url('/about')} class="link">Read the full letter<Icon name="arrow_forward" size={18} /></a>
            <a href={config.githubUrl} target="_blank" rel="noopener" class="link muted">GitHub<Icon name="north_east" size={18} /></a>
            <a href={config.portfolioUrl} target="_blank" rel="noopener" class="link muted">singhgautam.com<Icon name="north_east" size={18} /></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Reviews />

  <!-- Final call to action -->
  <section class="sec cta-sec" aria-labelledby="cta">
    <div class="wrap hero-gutter">
      <div class="cta" data-reveal>
        <BrandMark size={72} />
        <h2 id="cta" class="t-headline">Start tracking today</h2>
        <p class="t-lead">Free to download. Under 17 MB. No account needed.</p>
        <PlayBadge lg />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero: panel height = first screen minus nav space and trust strip, so the
     strip is visible without scrolling. Type and spacing shrink on short
     screens; the phone is clipped at the panel's bottom edge. */
  .hero-screen {
    --top: 88px;
    --trust: 80px;
    /* Phone scale = the smaller of a width step and a height step. */
    --s-w: 1;
    --s-h: 1;
    --s: min(var(--s-w), var(--s-h));
    --phone-top: clamp(24px, 4svh, 48px);
    padding-top: var(--top);
  }
  .hero {
    height: calc(100svh - var(--top) - var(--trust));
    min-height: 480px;
    /* Never taller than the full-size phone plus space above and below. */
    max-height: calc(796px * var(--s-w) + 2 * var(--phone-top));
    padding: 0 72px;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) auto;
    grid-template-rows: minmax(0, 1fr);
    gap: 48px;
    overflow: hidden;
  }
  .hero-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(12px, 2.6svh, 24px);
    padding: clamp(24px, 5svh, 72px) 0;
    max-width: 600px;
  }
  .hero .t-hero {
    font-size: min(var(--k-type-hero), 10.5svh);
  }
  .status {
    align-self: flex-start;
    background: var(--k-surface);
    padding: 0 14px 0 10px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--k-income);
  }
  .t-hero .accent {
    color: var(--k-primary);
  }
  .t-hero span {
    display: inline-block;
  }
  .hero .t-lead {
    max-width: 520px;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 8px;
  }
  /* The phone is centred, so the space above and below it is equal. */
  .hero-phone {
    display: flex;
    justify-content: center;
    align-items: center;
    padding-block: var(--phone-top);
  }
  .trust {
    list-style: none;
    margin: 0;
    height: var(--trust);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-content: center;
    gap: 12px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .a-in {
      animation: rise-in var(--k-dur-sheet) var(--k-ease) both;
      animation-delay: var(--d);
    }
    .a-phone {
      animation: rise-in-phone 400ms var(--k-ease) 120ms both;
    }
  }
  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  @keyframes rise-in-phone {
    from {
      opacity: 0;
      transform: translateY(32px);
    }
  }

  /* Signature (design H1) */
  .sig-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: 48px;
  }
  .sig {
    position: relative;
    border-radius: var(--k-r-2xl);
    background: var(--k-surface-container-low);
    border: 1px solid var(--k-outline-variant);
    padding: 32px 32px 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: background-color var(--k-dur-fast) var(--k-ease), border-color var(--k-dur-fast) var(--k-ease);
  }
  .sig:hover {
    background: var(--k-surface-container);
    border-color: var(--k-outline);
  }
  .sig:has(.sig-link:focus-visible) {
    outline: 3px solid var(--k-primary);
    outline-offset: 3px;
  }
  /* Stretch the card's link over the whole card. */
  .sig-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .sig-link:focus-visible {
    outline: none;
  }
  .sig.wide {
    grid-column: span 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 32px;
    align-items: start;
  }
  .sig-text {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .sig.wide .sig-text {
    max-width: 420px;
    padding-bottom: 32px;
  }
  .sig-text h3 {
    margin-top: 8px;
  }
  .sig-text .link {
    margin-top: 4px;
    align-self: flex-start;
  }
  .sig-tile {
    width: 48px;
    height: 48px;
    border-radius: 14px;
  }
  .sig-img {
    height: 260px;
    overflow: hidden;
    display: flex;
    justify-content: center;
    margin-top: 24px;
  }
  .sig-img :global(.shot) {
    width: 250px;
    align-self: flex-start;
  }
  .sig.wide .sig-img {
    height: 360px;
    margin: 0;
    align-self: end;
  }
  .sig.wide .sig-img :global(.shot) {
    width: 300px;
  }

  /* Themes */
  .themes {
    padding: clamp(32px, 6svh, 56px) 56px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 64px;
    align-items: center;
  }
  .themes-text {
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }
  .themes .shead {
    max-width: 640px;
  }
  .themes-phone {
    --s: 0.8;
  }
  @media (max-height: 900px) and (min-width: 1024px) {
    .themes-phone {
      --s: 0.72;
    }
  }

  /* Numbers */
  .nums {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 16px;
    margin: 40px 0 0;
  }
  .num {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 6px;
  }
  .num dd {
    margin: 0;
  }

  /* Banks */
  .banks-sec {
    padding-top: 56px;
  }
  .banks {
    border-top: 1px solid var(--k-outline-variant);
    padding-top: 40px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .banks-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .bank-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* Developer */
  .dev {
    border-radius: var(--k-r-3xl);
    padding: 56px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 40px;
    align-items: center;
  }
  .avatar {
    width: 104px;
    height: 104px;
    border-radius: 999px;
    background: var(--k-primary-container);
    color: var(--k-on-primary-container);
    display: flex;
    align-items: center;
    justify-content: center;
    font: 700 36px/1 var(--k-font);
    letter-spacing: -0.5px;
  }
  .dev-text {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .dev-p {
    font: 500 var(--k-type-title-l) / 1.3 var(--k-font);
    letter-spacing: -0.014em;
    max-width: 760px;
    text-wrap: pretty;
  }
  .dev-links {
    display: flex;
    gap: 8px 20px;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  /* CTA */
  .cta-sec {
    padding-bottom: var(--k-section);
  }
  .cta {
    border-radius: clamp(32px, 3vw, 48px);
    background: var(--k-primary-container);
    color: var(--k-on-primary-container);
    padding: clamp(40px, 7svh, 72px) 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
  }
  .cta h2 {
    margin-top: 8px;
  }
  .cta .t-lead {
    color: var(--k-on-primary-container);
    max-width: 440px;
  }
  .cta :global(.play) {
    margin-top: 16px;
  }

  @media (max-width: 1023px) {
    .sig-grid {
      grid-template-columns: 1fr 1fr;
    }
    .hero-screen {
      --s-w: 0.82;
    }
    .hero {
      padding: 0 40px;
      gap: 24px;
    }
    .themes {
      padding: 48px 40px;
      gap: 32px;
    }
    .themes-phone {
      --s: 0.78;
    }
    .nums {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 899px) {
    .themes {
      grid-template-columns: 1fr;
    }
    .themes-phone {
      justify-self: center;
    }
  }
  @media (max-width: 767px) {
    .hero-screen {
      --top: 80px;
      --trust: 96px;
    }
    .hero {
      display: flex;
      flex-direction: column;
      gap: 0;
      padding: 0 20px;
      min-height: 420px;
      max-height: none;
    }
    .hero-text {
      justify-content: flex-start;
      padding: clamp(24px, 4svh, 40px) 0 0;
      gap: clamp(10px, 2svh, 16px);
      flex: none;
    }
    .hero .t-hero {
      font-size: min(44px, 6.5svh);
    }
    .hero .t-lead {
      font-size: 16px;
      line-height: 24px;
    }
    .hero-actions {
      gap: 4px 8px;
      margin-top: 4px;
    }
    .see-all {
      padding: 0 8px;
      font-size: 14px;
    }
    .hero-actions :global(.play) {
      height: 48px;
      padding: 0 14px 0 12px;
      gap: 10px;
    }
    .hero-actions :global(.play-l) {
      font-size: 17px;
      line-height: 20px;
    }
    /* The phone takes whatever height is left and is clipped. */
    .hero-phone {
      flex: 1;
      min-height: 0;
      align-items: flex-start;
      padding-top: 24px;
    }
    .trust {
      gap: 8px;
    }
    .trust .chip {
      height: 28px;
      padding: 0 10px;
      font-size: 12px;
      gap: 6px;
    }
  }
  @media (max-width: 599px) {
    .sig-grid {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-top: 32px;
    }
    .sig,
    .sig.wide {
      grid-column: auto;
      display: flex;
      padding: 24px 24px 0;
      border-radius: 28px;
    }
    .sig.wide .sig-text {
      padding-bottom: 0;
    }
    .sig-img,
    .sig.wide .sig-img {
      height: 240px;
      margin-top: 24px;
      align-self: auto;
    }
    .sig-img :global(.shot),
    .sig.wide .sig-img :global(.shot) {
      width: 240px;
    }
    .hero-gutter {
      padding: 0 12px;
    }
    .themes {
      padding: 40px 20px;
      gap: 40px;
    }
    .themes-phone {
      --s: 0.8;
    }
    .nums {
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-top: 32px;
    }
    .num:last-child {
      grid-column: span 2;
    }
    .num {
      padding: 20px;
    }
    .dev {
      grid-template-columns: 1fr;
      padding: 28px;
      gap: 24px;
      border-radius: 28px;
    }
    .avatar {
      width: 72px;
      height: 72px;
      font-size: 26px;
    }
    .cta {
      padding: 48px 24px;
    }
    .cta :global(svg:first-child) {
      width: 56px;
      height: 56px;
    }
    .banks-sec {
      padding-top: 40px;
    }
    .banks {
      padding-top: 32px;
    }
  }
  @media (max-width: 370px) {
    .hero-screen {
      --s-w: 0.74;
    }
    .themes-phone {
      --s: 0.74;
    }
  }
  /* Two-column hero: the whole phone fits in the panel with equal space
     above and below. Each step is (0.92 × height − 168) / 796 at the bottom of
     its band: panel = height − nav space − trust strip, minus 2 × 4svh. */
  @media (min-width: 768px) {
    @media (max-height: 1059px) { .hero-screen { --s-h: 0.94; } }
    @media (max-height: 999px) { .hero-screen { --s-h: 0.87; } }
    @media (max-height: 939px) { .hero-screen { --s-h: 0.8; } }
    @media (max-height: 879px) { .hero-screen { --s-h: 0.73; } }
    @media (max-height: 819px) { .hero-screen { --s-h: 0.66; } }
    @media (max-height: 759px) { .hero-screen { --s-h: 0.59; } }
    @media (max-height: 699px) { .hero-screen { --s-h: 0.52; } }
    @media (max-height: 639px) { .hero-screen { --s-h: 0.5; } }
  }
</style>
