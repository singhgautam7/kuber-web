---
import { getCollection } from 'astro:content';
import { config } from '@/config';
import BaseLayout from '@/layouts/BaseLayout.astro';

const entries = (await getCollection('changelog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const fmt = (d: Date) => d.toLocaleDateString('en-IN', { month: 'long', year: 'numeric' });
---
<BaseLayout title="Changelog" description="Every Kuber release, newest first. No account, no cloud, no surprises." footerMaxWidth={820}>
  <header class="cl-header">
    <div class="eyebrow">CHANGELOG</div>
    <h1 class="cl-title">What's new</h1>
    <p class="cl-intro">Every release, newest first. No account, no cloud, no surprises.</p>
  </header>

  <section class="cl-section">
    <div class="cl-entries">
      {entries.map((e) => (
        <article class="cl-entry" data-entry>
          <div class="cl-meta">
            <div class="cl-date mono">{fmt(e.data.date)}</div>
            {e.data.version && <div class="cl-version mono">v{e.data.version}</div>}
          </div>
          <div class="cl-content">
            <div class="cl-title-row">
              <h2 class="cl-entry-title">{e.data.title}</h2>
              {e.data.latest && <span class="cl-latest">LATEST</span>}
            </div>
            {e.data.summary && <p class="cl-summary">{e.data.summary}</p>}
            {e.data.points && e.data.points.length > 0 && (
              <ul class="cl-points">
                {e.data.points.map((p) => <li>{p}</li>)}
              </ul>
            )}
          </div>
        </article>
      ))}
    </div>
    <div class="cl-more">
      <a href={config.githubUrl} target="_blank" rel="noopener" class="cl-more-link">See all releases on GitHub</a>
    </div>
  </section>
</BaseLayout>

<style>
  .eyebrow { font: 700 12px var(--font-sans); letter-spacing: 1.6px; color: var(--k-accent-text); margin-bottom: 12px; }
  .cl-header { max-width: 820px; margin: 0 auto; padding: 56px 22px 20px; }
  .cl-title { font-family: var(--font-sans); font-weight: 900; font-size: var(--fs-display); letter-spacing: -0.042em; line-height: 1; margin: 0; }
  .cl-intro { font-family: var(--font-sans); font-weight: 400; font-size: var(--fs-lead); line-height: 1.6; color: var(--k-text-sec); margin: 14px 0 0; max-width: 480px; }
  .cl-section { max-width: 820px; margin: 0 auto; padding: 20px 22px 60px; }
  .cl-entries { display: flex; flex-direction: column; }
  .cl-entry { display: grid; grid-template-columns: 150px 1fr; gap: 24px; padding: 26px 0; border-top: 1px solid var(--k-border); }
  .cl-date { font: 600 13px var(--font-mono); color: var(--k-text-sec); }
  .cl-version { display: inline-flex; align-items: center; margin-top: 10px; font: 700 12px var(--font-mono); color: var(--k-accent-text); background: var(--k-accent-subtle); border: 1px solid var(--k-accent-ring); border-radius: 6px; padding: 4px 9px; }
  .cl-title-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .cl-entry-title { font: 800 22px var(--font-sans); letter-spacing: -0.5px; margin: 0; }
  .cl-latest { font: 700 9px var(--font-sans); letter-spacing: 0.6px; color: var(--k-on-accent); background: var(--k-accent); border-radius: 5px; padding: 3px 7px; }
  .cl-summary { font: 400 15px/1.7 var(--font-sans); color: var(--k-text-sec); margin: 12px 0 0; }
  .cl-points { font: 400 15px/1.8 var(--font-sans); color: var(--k-text); margin: 14px 0 0; padding-left: 20px; }
  .cl-points li::marker { color: var(--k-text-sec); }
  .cl-more { text-align: center; padding-top: 34px; border-top: 1px solid var(--k-border); }
  .cl-more-link { font: 600 14px var(--font-sans); color: var(--k-text); background: var(--k-card); border: 1px solid var(--k-border); border-radius: 10px; padding: 11px 22px; display: inline-block; }
  @media (max-width: 620px) {
    .cl-entry { grid-template-columns: 1fr; gap: 10px; }
  }
</style>
