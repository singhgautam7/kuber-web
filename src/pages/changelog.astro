---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

const entries = (await getCollection('changelog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const fmt = (d: Date) => d.toLocaleDateString('en-IN', { month: 'long', year: 'numeric' });
---
<BaseLayout title="Changelog" description="Every Kuber release, newest first. No account, no cloud, no surprises.">
  <div class="wrap">
    <div class="col">
      <header class="page-top shead">
        <div class="eyebrow">Changelog</div>
        <h1 class="t-display">What's new</h1>
        <p class="t-lead">Every release, newest first. No account, no cloud, no surprises.</p>
      </header>
      <ol class="list">
        {entries.map((e) => (
          <li class="entry">
            <div class="meta">
              <span class="t-label">{fmt(e.data.date)}</span>
              {e.data.version && <span class="t-cap muted mono">v{e.data.version}</span>}
            </div>
            <div class="content">
              <div class="title">
                <h2 class="t-title-l">{e.data.title}</h2>
                {e.data.latest && <span class="badge latest">Latest</span>}
              </div>
              {e.data.summary && <p class="muted">{e.data.summary}</p>}
              {e.data.points && <ul>{e.data.points.map((p) => <li>{p}</li>)}</ul>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</BaseLayout>

<style>
  .latest {
    background: var(--k-primary-container);
    color: var(--k-on-primary-container);
  }
  .col {
    max-width: 820px;
    margin: 0 auto;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 64px 0 var(--k-section);
  }
  .entry {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    gap: 32px;
    padding: 32px 0;
  }
  .entry + .entry {
    border-top: 1px solid var(--k-outline-variant);
  }
  .meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .mono {
    font-family: var(--k-mono);
  }
  .content {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .title {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  ul {
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  @media (max-width: 599px) {
    .entry {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .meta {
      flex-direction: row;
      gap: 12px;
      align-items: center;
    }
    .list {
      padding-top: 40px;
    }
  }
</style>
