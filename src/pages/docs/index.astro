---
import { url } from '@/lib/url';
import { docsHub } from '@/lib/docs';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';

const { groups, published, soon } = await docsHub();
const lead = 'Guides, security deep-dives and legal policies. Your data stays on your device, so the docs can be short and plain.';
---
<BaseLayout title="Documentation & Guides" description="Guides, security deep-dives, and legal policies for Kuber. Transparent, open, and straightforward." ogType="article">
  <div class="wrap">
    <header class="page-top head">
      <div class="shead">
        <div class="eyebrow">Docs</div>
        <h1 class="t-display">Everything you need to know about Kuber</h1>
        <p class="t-lead">{lead}</p>
      </div>
      <div class="status t-body-s muted">
        <span><span class="dot live"></span>{published} published</span>
        <span><span class="dot"></span>{soon} in progress</span>
      </div>
    </header>

    <div class="groups">
      {groups.map((g, gi) => {
        const live = g.docs.filter((d) => d.live);
        const later = g.docs.filter((d) => !d.live);
        return (
          <section aria-labelledby={`g${gi}`}>
            <div class="g-head">
              <div><h2 id={`g${gi}`} class="t-title-l">{g.title}</h2><p class="muted">{g.description}</p></div>
              <span class="t-cap muted mono">{'ABCD'[gi]} · {g.docs.length} docs</span>
            </div>
            {live.length > 0 && (
              <div class="cards">
                {live.map((d) => {
                  const href = d.href ?? url(`/docs/${d.slug}`);
                  const ext = !!d.href;
                  return (
                    <a href={href} class="doc sl" {...(ext ? { target: '_blank', rel: 'noopener' } : {})}>
                      <span class="doc-top"><span class="tile"><Icon name={d.icon} size={22} /></span><span class="pub t-cap">Published</span></span>
                      <span class="t-title-m">{d.title}</span>
                      <span class="t-body-s muted">{d.description}</span>
                      <span class="doc-foot"><span class="t-cap muted mono">{ext ? href.replace(/^https?:\/\//, '').replace(/\/$/, '') : `/docs/${d.slug}`}</span><Icon name={ext ? 'arrow_outward' : 'arrow_forward'} size={20} /></span>
                    </a>
                  );
                })}
              </div>
            )}
            {later.length > 0 && (
              <ul class="soon" aria-label={`${g.title}: coming soon`}>
                {later.map((d) => (
                  <li>
                    <Icon name={d.icon} size={20} class="muted" />
                    <span class="soon-text"><span class="t-title-s">{d.title}</span><span class="t-body-s muted">{d.description}</span></span>
                    <span class="soon-chip t-cap">Coming soon</span>
                  </li>
                ))}
              </ul>
            )}
          </section>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style>
  .head {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .head .shead {
    max-width: 820px;
  }
  .status {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
  }
  .status > span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    border: 1.5px solid var(--k-outline);
  }
  .dot.live {
    background: var(--k-income);
    border-color: var(--k-income);
  }
  .groups {
    display: flex;
    flex-direction: column;
    gap: 72px;
    padding: 64px 0 var(--k-section);
  }
  section {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .g-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .g-head p {
    margin-top: 6px;
  }
  .mono {
    font-family: var(--k-mono);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .doc {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    border-radius: var(--k-r-xl);
    background: var(--k-surface-container-low);
    border: 1px solid var(--k-outline-variant);
    color: var(--k-on-surface);
    text-decoration: none;
  }
  .doc:hover {
    border-color: var(--k-outline);
  }
  .doc-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .pub {
    height: 24px;
    padding: 0 10px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    background: var(--k-income-container);
    color: var(--k-on-income-container);
    font-weight: 600;
  }
  .doc .t-title-m {
    margin-top: 4px;
  }
  .doc-foot {
    margin-top: auto;
    padding-top: 4px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    color: var(--k-primary);
  }
  .soon {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px dashed var(--k-outline);
    border-radius: var(--k-r-l);
  }
  .soon li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 20px;
  }
  .soon li + li {
    border-top: 1px solid var(--k-outline-variant);
  }
  .soon-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .soon-chip {
    height: 24px;
    padding: 0 10px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    background: var(--k-surface-container-high);
    color: var(--k-on-surface-variant);
    font-weight: 600;
    white-space: nowrap;
    flex: none;
  }
  @media (max-width: 1023px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 599px) {
    .cards {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .groups {
      gap: 48px;
      padding-top: 40px;
    }
    .soon li {
      flex-wrap: wrap;
      padding: 14px 16px;
    }
  }
</style>
