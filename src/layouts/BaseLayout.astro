---
/**
 * Base document for every page: the no-flash theme script, SEO, font preload,
 * skip link, nav, the one footer and the site controller.
 */
import '@/styles/global.css';
import Seo from '@/components/Seo.astro';
import NavBar from '@/components/NavBar.astro';
import Footer from '@/components/Footer.astro';
import { FAMILY_IDS } from '@/lib/themes';
import { asset } from '@/lib/url';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
}
const { title, description, ogImage, ogType } = Astro.props;
const fams = FAMILY_IDS;
---
<!doctype html>
<html lang="en" data-theme="signature">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <!-- Theme before first paint: saved {fam, mode} or the system preference.
         Storage can throw (blocked cookies, private mode), hence the try. -->
    <script is:inline define:vars={{ fams }}>
      var d = document.documentElement, f = 'signature', m = 'system';
      d.classList.add('js');
      try {
        var s = JSON.parse(localStorage.getItem('kuber-theme') || '{}');
        if (s.fam) f = s.fam;
        if (s.mode) m = s.mode;
      } catch (e) {}
      if (fams.indexOf(f) < 0) f = 'signature';
      var dark = m === 'dark' || (m !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
      d.setAttribute('data-theme', f);
      d.setAttribute('data-mode', dark ? 'dark' : 'light');
      d.setAttribute('data-pref', m);
      d.style.colorScheme = dark ? 'dark' : 'light';
    </script>
    <link rel="preload" href={asset('/fonts/inter-var.woff2')} as="font" type="font/woff2" crossorigin />
    <Seo title={title} description={description} ogImage={ogImage} ogType={ogType} />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <NavBar />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '@/scripts/site.ts';
    </script>
  </body>
</html>
