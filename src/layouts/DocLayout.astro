---
/**
 * Documentation layout: sticky TOC sidebar + prose article, matching Docs.dc.html.
 * The TOC is built from the rendered headings passed in by the page.
 */
import BaseLayout from './BaseLayout.astro';

export interface TocItem {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  lastUpdated?: Date;
  toc?: TocItem[];
  showToc?: boolean;
}
const {
  title,
  description,
  eyebrow = 'DOCUMENTATION',
  lastUpdated,
  toc = [],
  showToc = true,
} = Astro.props;

const tocItems = toc.filter((h) => h.depth === 2);
const updated = lastUpdated
  ? lastUpdated.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' })
  : null;
---
<BaseLayout title={title} description={description} ogType="article" footerMaxWidth={1060}>
  <div class="docwrap" data-docwrap>
    {showToc && tocItems.length > 0 && (
      <aside class="toc" data-toc>
        <div class="toc-sticky">
          <div class="toc-head">ON THIS PAGE</div>
          <nav class="toc-list" aria-label="On this page">
            {tocItems.map((h) => (
              <a href={`#${h.slug}`} class="toc-link">{h.text}</a>
            ))}
          </nav>
        </div>
      </aside>
    )}
    <article class="doc-article">
      <div class="doc-eyebrow">{eyebrow}</div>
      <h1 class="doc-title">{title}</h1>
      {updated && (
        <div class="doc-updated">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M3 10h18M8 2v4M16 2v4"></path></svg>
          Last updated {updated}
        </div>
      )}
      <div class="prose doc-body">
        <slot />
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .docwrap {
    max-width: 1060px;
    margin: 0 auto;
    padding: 44px 22px 70px;
    display: grid;
    grid-template-columns: 230px 1fr;
    gap: 44px;
  }
  .toc-sticky {
    position: sticky;
    top: 88px;
  }
  .toc-head {
    font: 700 11px var(--font-sans);
    letter-spacing: 1.3px;
    color: var(--k-text-sec);
    margin-bottom: 14px;
  }
  .toc-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-left: 1px solid var(--k-border);
  }
  .toc-link {
    font: 500 13.5px var(--font-sans);
    color: var(--k-text-sec);
    padding: 6px 0 6px 14px;
    margin-left: -1px;
    border-left: 2px solid transparent;
  }
  .toc-link:hover {
    color: var(--k-text);
    border-left-color: var(--k-accent-ring);
  }
  .doc-article {
    min-width: 0;
  }
  .doc-eyebrow {
    font: 700 12px var(--font-sans);
    letter-spacing: 1.6px;
    color: var(--k-accent-text);
    margin-bottom: 10px;
  }
  .doc-title {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: clamp(2rem, 3vw, 2.75rem);
    letter-spacing: -0.038em;
    margin: 0;
  }
  .doc-updated {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    font: 500 13px var(--font-sans);
    color: var(--k-text-sec);
    background: var(--k-muted);
    border: 1px solid var(--k-border);
    border-radius: 999px;
    padding: 6px 13px;
  }
  .doc-body {
    margin-top: 28px;
  }
  @media (max-width: 820px) {
    .docwrap {
      grid-template-columns: 1fr;
    }
    .toc {
      display: none;
    }
  }
</style>
