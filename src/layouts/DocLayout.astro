---
/**
 * Doc page (Web v1 D2): docs sidebar, article (720), On this page. Both side
 * columns are sticky on desktop; on mobile they collapse into two native
 * disclosure pickers. Legal text is rendered as written; only the look changes.
 */
import BaseLayout from './BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { url } from '@/lib/url';
import { docsHub } from '@/lib/docs';

export interface TocItem {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  title: string;
  slug: string;
  description?: string;
  lastUpdated?: Date;
  toc?: TocItem[];
  showToc?: boolean;
  words: number;
}
const { title, slug, description, lastUpdated, toc = [], showToc = true, words } = Astro.props;
const tocItems = showToc ? toc.filter((h) => h.depth === 2) : [];
const updated = lastUpdated?.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
const minutes = Math.max(1, Math.round(words / 200));

const { groups } = await docsHub();
const group = groups.find((g) => g.docs.some((d) => d.slug === slug));
const internal = groups.flatMap((g) => g.docs).filter((d) => d.live && d.slug);
const next = internal[internal.findIndex((d) => d.slug === slug) + 1];
---
<BaseLayout title={title} description={description} ogType="article">
  {(() => {
    const sidebar = (
      <nav aria-label="Docs" class="side-nav">
        {groups.map((g) => (
          <div class="side-group">
            <div class="eyebrow muted">{g.title}</div>
            {g.docs.map((d) =>
              d.live ? (
                <a href={d.href ?? url(`/docs/${d.slug}`)} class:list={['side-link sl', { on: d.slug === slug }]} aria-current={d.slug === slug ? 'page' : undefined} {...(d.href ? { target: '_blank', rel: 'noopener' } : {})}>
                  {d.title}
                </a>
              ) : (
                <span class="side-link soon">{d.title}<span class="t-cap">Soon</span></span>
              ),
            )}
          </div>
        ))}
      </nav>
    );
    const tocNav = tocItems.length > 0 && (
      <nav aria-label="On this page" class="toc-nav">
        {tocItems.map((h) => <a href={`#${h.slug}`} class="toc-link">{h.text}</a>)}
      </nav>
    );
    return (
      <div class="wrap">
        <div class="page-top doc">
          <div class="pickers">
            <details class="picker">
              <summary><Icon name="menu_book" size={20} /><span class="t-label">Docs · {title}</span><Icon name="expand_more" size={22} class="chev" /></summary>
              {sidebar}
            </details>
            {tocNav && (
              <details class="picker">
                <summary><Icon name="toc" size={20} /><span class="t-label">On this page</span><Icon name="expand_more" size={22} class="chev" /></summary>
                {tocNav}
              </details>
            )}
          </div>
          <aside class="side">{sidebar}</aside>
          <article class="article">
            <nav aria-label="Breadcrumb" class="crumbs t-body-s">
              <a href={url('/docs')}>Docs</a><Icon name="chevron_right" size={18} />
              {group && <><span>{group.title}</span><Icon name="chevron_right" size={18} /></>}
              <span aria-current="page">{title}</span>
            </nav>
            <h1 class="t-display">{title}</h1>
            <div class="meta t-body-s muted">
              {updated && <span><Icon name="event" size={18} />Last updated {updated}</span>}
              <span><Icon name="schedule" size={18} />{minutes} min read</span>
            </div>
            <div class="rule"></div>
            <div class="prose"><slot /></div>
            {next && (
              <a href={url(`/docs/${next.slug}`)} class="next sl">
                <span class="t-cap muted">Next</span>
                <span class="t-title-s next-t">{next.title}<Icon name="arrow_forward" size={20} /></span>
              </a>
            )}
          </article>
          {tocNav && <aside class="toc"><div class="eyebrow muted toc-head">On this page</div>{tocNav}</aside>}
        </div>
      </div>
    );
  })()}
</BaseLayout>

<style>
  .doc {
    display: grid;
    grid-template-columns: 248px minmax(0, 720px) 200px;
    gap: 48px;
    align-items: start;
    justify-content: center;
    padding-bottom: var(--k-section);
  }
  .pickers {
    display: none;
  }
  .side,
  .toc {
    position: sticky;
    top: 96px;
    max-height: calc(100dvh - 120px);
    overflow-y: auto;
  }
  .side-nav {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .side-group {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .side-group .eyebrow {
    padding: 0 12px 6px;
  }
  .side-link {
    min-height: 40px;
    padding: 0 12px;
    border-radius: var(--k-r-full);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    font: 400 14px/20px var(--k-font);
    color: var(--k-on-surface);
    text-decoration: none;
  }
  .side-link.on {
    background: var(--k-secondary-container);
    color: var(--k-on-secondary-container);
    font-weight: 600;
  }
  .side-link.soon {
    color: var(--k-on-surface-variant);
  }
  .article {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
  }
  .crumbs {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    color: var(--k-on-surface-variant);
  }
  .crumbs a {
    color: var(--k-on-surface-variant);
  }
  .crumbs [aria-current] {
    color: var(--k-on-surface);
  }
  .article h1 {
    margin-top: 8px;
  }
  .meta {
    display: flex;
    gap: 8px 20px;
    flex-wrap: wrap;
  }
  .meta span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .rule {
    height: 1px;
    background: var(--k-outline-variant);
    margin: 8px 0;
  }
  .next {
    margin-top: 40px;
    margin-left: auto;
    width: min(100%, 340px);
    display: flex;
    flex-direction: column;
    gap: 4px;
    align-items: flex-end;
    text-align: right;
    padding: 18px 20px;
    border-radius: var(--k-r-l);
    background: var(--k-surface-container-low);
    border: 1px solid var(--k-outline-variant);
    text-decoration: none;
  }
  .next-t {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--k-primary);
  }
  .toc-head {
    padding: 0 0 10px 14px;
  }
  .toc-nav {
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--k-outline-variant);
  }
  .toc-link {
    padding: 6px 0 6px 14px;
    margin-left: -1px;
    border-left: 2px solid transparent;
    font: 400 14px/20px var(--k-font);
    color: var(--k-on-surface-variant);
    text-decoration: none;
  }
  .toc-link:hover {
    color: var(--k-on-surface);
    border-left-color: var(--k-primary);
  }
  @media (max-width: 1199px) {
    .doc {
      grid-template-columns: 220px minmax(0, 720px);
    }
    .toc {
      display: none;
    }
  }
  @media (max-width: 899px) {
    .doc {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
    .side {
      display: none;
    }
    .pickers {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .picker {
      border: 1px solid var(--k-outline-variant);
      border-radius: var(--k-r-m);
      background: var(--k-surface-container);
    }
    .picker summary {
      height: 48px;
      padding: 0 12px 0 16px;
      display: flex;
      align-items: center;
      gap: 12px;
      cursor: pointer;
      list-style: none;
      color: var(--k-on-surface-variant);
    }
    .picker summary::-webkit-details-marker {
      display: none;
    }
    .picker summary .t-label {
      flex: 1;
      color: var(--k-on-surface);
    }
    .picker[open] :global(.chev) {
      transform: rotate(180deg);
    }
    .picker > nav {
      padding: 8px 8px 16px;
    }
    .picker .toc-nav {
      margin: 0 16px;
    }
  }
</style>
