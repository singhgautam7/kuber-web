---
/**
 * Documentation card component for the /docs hub page.
 * Supports active/live links and coming soon states.
 */
interface Props {
  title: string;
  description: string;
  href?: string;
  pathText: string;
  status: 'live' | 'coming-soon';
  actionLabel?: string;
  isExternal?: boolean;
}

const {
  title,
  description,
  href,
  pathText,
  status,
  actionLabel = 'Read more',
  isExternal = false,
} = Astro.props;

const isLive = status === 'live' && Boolean(href);
---

{isLive ? (
  <a
    href={href}
    target={isExternal ? '_blank' : undefined}
    rel={isExternal ? 'noopener' : undefined}
    class="doc-card doc-card-live"
  >
    <div class="doc-card-top">
      <span class="doc-card-icon doc-icon-live">
        <slot name="icon" />
      </span>
      <span class="doc-badge doc-badge-live">Live</span>
    </div>
    <div class="doc-card-title">{title}</div>
    <p class="doc-card-desc">{description}</p>
    <span class="doc-card-action">
      {actionLabel}
      {isExternal ? (
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 17L17 7M9 7h8v8"></path>
        </svg>
      ) : (
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      )}
    </span>
    <span class="doc-card-path">{pathText}</span>
  </a>
) : (
  <div class="doc-card doc-card-muted">
    <div class="doc-card-top">
      <span class="doc-card-icon doc-icon-muted">
        <slot name="icon" />
      </span>
      <span class="doc-badge doc-badge-coming-soon">Coming Soon</span>
    </div>
    <div class="doc-card-title">{title}</div>
    <p class="doc-card-desc">{description}</p>
    <span class="doc-card-path doc-path-muted">{pathText}</span>
  </div>
)}

<style>
  .doc-card {
    display: flex;
    flex-direction: column;
    background: var(--k-card);
    border: 1px solid var(--k-border);
    border-radius: 14px;
    padding: 20px;
    color: var(--k-text);
  }

  .doc-card-live {
    cursor: pointer;
    transition: border-color 0.18s ease, transform 0.18s ease;
  }
  .doc-card-live:hover {
    border-color: var(--k-accent-ring);
    transform: translateY(-2px);
  }

  .doc-card-muted {
    opacity: 0.88;
  }

  .doc-card-top {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 14px;
  }

  .doc-card-icon {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .doc-icon-live {
    background: var(--k-accent-subtle);
    color: var(--k-accent-text);
  }

  .doc-icon-muted {
    background: var(--k-muted);
    color: var(--k-text-sec);
  }

  .doc-badge {
    margin-left: auto;
    font: 700 10px var(--font-sans);
    letter-spacing: 0.6px;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 6px;
  }

  .doc-badge-live {
    background: color-mix(in srgb, var(--k-income) 12%, transparent);
    color: var(--k-income);
    border: 1px solid color-mix(in srgb, var(--k-income) 30%, transparent);
  }

  .doc-badge-coming-soon {
    background: color-mix(in srgb, var(--k-warning) 12%, transparent);
    color: var(--k-warning);
    border: 1px solid color-mix(in srgb, var(--k-warning) 30%, transparent);
  }

  .doc-card-title {
    font: 700 17px var(--font-sans);
    letter-spacing: -0.3px;
    margin-bottom: 7px;
    color: var(--k-text);
  }

  .doc-card-desc {
    font: 400 14px/1.6 var(--font-sans);
    color: var(--k-text-sec);
    margin: 0 0 16px;
  }

  .doc-card-action {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font: 600 13px var(--font-sans);
    color: var(--k-accent-text);
  }

  .doc-card-path {
    font: 500 11.5px var(--font-mono);
    color: var(--k-text-sec);
    margin-top: 12px;
  }

  .doc-path-muted {
    margin-top: auto;
  }
</style>
