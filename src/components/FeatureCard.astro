---
/**
 * Feature card for the Features index (Web v1 F1): cropped first screenshot,
 * icon tile, badges, title, description. Below 600px it becomes a compact row
 * with a small thumbnail. data-* hooks drive the client filter.
 */
import type { CollectionEntry } from 'astro:content';
import { url } from '@/lib/url';
import { getFeatureShots } from '@/lib/screenshots';
import Icon from './Icon.astro';
import Badges from './Badges.astro';
import Screenshot from './Screenshot.astro';

interface Props {
  feature: CollectionEntry<'features'>['data'];
}
const { feature: f } = Astro.props;
const shot = getFeatureShots(f.slug)[0];
---
<a href={url(`/features/${f.slug}`)} class="fc sl" data-feature data-plan={f.plan} data-beta={String(f.beta)} data-sig={String(f.signature)}>
  {shot && <span class="fc-img" aria-hidden="true"><Screenshot shot={shot} width={180} alt="" /></span>}
  <span class="fc-body">
    <span class="fc-top">
      <span class="tile"><Icon name={f.iconName ?? 'apps'} size={22} /></span>
      <Badges plan={f.plan} beta={f.beta} />
    </span>
    <span class="t-title-m fc-title">{f.title}</span>
    <span class="t-body-s muted">{f.description}</span>
  </span>
</a>

<style>
  .fc {
    display: flex;
    flex-direction: column;
    border-radius: var(--k-r-xl);
    background: var(--k-surface-container-low);
    border: 1px solid var(--k-outline-variant);
    overflow: hidden;
    color: var(--k-on-surface);
    text-decoration: none;
  }
  .fc:hover {
    background: var(--k-surface-container);
    border-color: var(--k-outline);
  }
  .fc:focus-visible {
    outline-offset: 3px;
  }
  .fc[hidden] {
    display: none;
  }
  .fc-img {
    height: 200px;
    background: var(--k-surface-container);
    overflow: hidden;
    display: flex;
    justify-content: center;
    padding-top: 24px;
    border-bottom: 1px solid var(--k-outline-variant);
  }
  .fc-img :global(.shot) {
    width: 180px;
    border-radius: 20px 20px 0 0;
    align-self: flex-start;
  }
  .fc-body {
    padding: 20px 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .fc-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .fc-title {
    margin-top: 8px;
  }
  .t-body-s {
    text-wrap: pretty;
  }
  @media (max-width: 599px) {
    .fc {
      flex-direction: row-reverse;
      align-items: flex-start;
      position: relative;
      min-height: 112px;
      border-radius: var(--k-r-l);
    }
    .fc-img {
      position: absolute;
      right: -6px;
      top: 14px;
      width: 72px;
      height: 120px;
      padding: 0;
      border: none;
      border-radius: 12px 0 0 0;
      background: none;
    }
    .fc-img :global(.shot) {
      width: 72px;
      border-radius: 12px 0 0 0;
    }
    .fc-body {
      padding: 16px 92px 16px 16px;
      gap: 6px;
    }
    .fc-title {
      margin-top: 4px;
      font-size: 16px;
      line-height: 24px;
    }
  }
</style>
