---
/**
 * Floating pill nav (Web v1 C1/C2): brand, the five sections, theme menu
 * (native popover) and, on mobile, a menu button that opens a bottom sheet
 * (native <dialog>: focus trap, Escape and inert background for free).
 * The "Get the app" FAB sits beside the pill on desktop, icon-only on tablet,
 * and fixed bottom-right on mobile. site.ts toggles html.scrolled and
 * html.past-hero; everything else here is CSS.
 */
import { config } from '@/config';
import { url } from '@/lib/url';
import BrandMark from './BrandMark.astro';
import Icon from './Icon.astro';
import ThemeMenu from './ThemeMenu.astro';

const links = [
  { label: 'Home', href: url('/'), icon: 'home' },
  { label: 'Features', href: url('/features'), icon: 'apps' },
  { label: 'Docs', href: url('/docs'), icon: 'description' },
  { label: 'About', href: url('/about'), icon: 'person' },
  { label: 'Press', href: url('/press'), icon: 'newspaper' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const h = href.replace(/\/$/, '') || '/';
  return h === '/' ? path === '/' : path === h || path.startsWith(h + '/');
};
---
<nav class="nav" aria-label="Main">
  <div class="pill">
    <a href={url('/')} class="brand" aria-label="Kuber home">
      <BrandMark size={32} />
      <span class="word">Kuber</span>
    </a>
    <span class="vdiv hide-m"></span>
    <div class="links hide-m">
      {links.map((l) => (
        <a href={l.href} class:list={['item sl', { on: isActive(l.href) }]} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </div>
    <span class="vdiv hide-m"></span>
    <span class="grow show-m"></span>
    <button type="button" class="ibtn sl" popovertarget="theme-menu" aria-label="Theme and mode" data-theme-toggle>
      <Icon name="palette" size={22} />
    </button>
    <button type="button" class="ibtn sl show-m" aria-label="Open menu" aria-haspopup="dialog" data-menu-open>
      <Icon name="menu" size={22} />
    </button>
  </div>
  <a href={config.playStoreUrl} target="_blank" rel="noopener" class="fab sl" aria-label="Get the app on Google Play">
    <Icon name="install_mobile" size={22} />
    <span class="fab-label">Get the app</span>
  </a>
</nav>

<div id="theme-menu" popover class="theme-pop" aria-label="Theme">
  <ThemeMenu />
</div>

<dialog class="sheet" aria-label="Menu" data-menu>
  <div class="handle" aria-hidden="true"></div>
  <div class="sheet-head">
    <span class="t-title-l">Menu</span>
    <button type="button" class="ibtn ibtn-c3 sl" aria-label="Close menu" data-menu-close>
      <Icon name="close" size={22} />
    </button>
  </div>
  <div class="sheet-links">
    {links.map((l) => (
      <a href={l.href} class:list={['sheet-item sl', { on: isActive(l.href) }]} aria-current={isActive(l.href) ? 'page' : undefined}>
        <Icon name={l.icon} size={24} fill={isActive(l.href)} />
        <span class="t-title-s">{l.label}</span>
      </a>
    ))}
  </div>
  <div class="sheet-div"></div>
  <div class="sheet-more">
    <a href={url('/changelog')} class="sl">Changelog</a>
    <a href={url('/docs/privacy-policy')} class="sl">Privacy Policy</a>
    <a href={config.githubUrl} target="_blank" rel="noopener" class="sl">GitHub</a>
  </div>
  <a href={config.playStoreUrl} target="_blank" rel="noopener" class="btn btn-filled btn-l has-icon sl sheet-cta">
    <Icon name="install_mobile" size={20} />Get the app on Google Play
  </a>
</dialog>

<style>
  .nav {
    position: fixed;
    left: 0;
    right: 0;
    top: 16px;
    z-index: 50;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    padding: 0 16px;
    pointer-events: none;
    transition: top var(--k-dur-nav) var(--k-ease);
  }
  .nav > * {
    pointer-events: auto;
  }
  .pill {
    height: 56px;
    padding: 8px;
    border-radius: var(--k-r-full);
    background: var(--k-surface);
    border: 1px solid var(--k-outline-variant);
    display: flex;
    align-items: center;
    gap: 2px;
    transition: height var(--k-dur-nav) var(--k-ease), padding var(--k-dur-nav) var(--k-ease),
      background-color var(--k-dur-nav) var(--k-ease);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 40px;
    padding: 0 14px 0 4px;
    border-radius: var(--k-r-full);
    color: var(--k-on-surface);
    text-decoration: none;
    flex: none;
  }
  .word {
    font: 700 17px/24px var(--k-font);
    letter-spacing: -0.2px;
  }
  .vdiv {
    width: 1px;
    height: 24px;
    background: var(--k-outline-variant);
    margin: 0 6px;
    flex: none;
  }
  .links {
    display: flex;
    gap: 2px;
  }
  .item {
    height: 40px;
    padding: 0 16px;
    border-radius: var(--k-r-full);
    display: flex;
    align-items: center;
    font: 600 14px/20px var(--k-font);
    letter-spacing: 0.1px;
    color: var(--k-on-surface-variant);
    text-decoration: none;
    white-space: nowrap;
    transition: height var(--k-dur-nav) var(--k-ease);
  }
  .item.on {
    background: var(--k-secondary-container);
    color: var(--k-on-secondary-container);
    --sl: var(--k-on-secondary-container);
  }
  .ibtn {
    width: 40px;
    height: 40px;
    border-radius: var(--k-r-full);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--k-on-surface-variant);
    flex: none;
    transition: width var(--k-dur-nav) var(--k-ease), height var(--k-dur-nav) var(--k-ease);
  }
  .ibtn[aria-expanded='true'] {
    background: var(--k-secondary-container);
    color: var(--k-on-secondary-container);
  }
  .ibtn-c3 {
    background: var(--k-surface-container-high);
    color: var(--k-on-surface);
  }
  .fab {
    height: 56px;
    padding: 0 22px 0 18px;
    border-radius: var(--k-r-full);
    background: var(--k-primary-container);
    color: var(--k-on-primary-container);
    --sl: var(--k-on-primary-container);
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex: none;
    overflow: hidden;
    transition: height var(--k-dur-nav) var(--k-ease), padding var(--k-dur-nav) var(--k-ease),
      width var(--k-dur-nav) var(--k-ease);
  }
  .fab-label {
    font: 600 15px/20px var(--k-font);
    letter-spacing: 0.1px;
    white-space: nowrap;
    transition: opacity var(--k-dur-nav) var(--k-ease);
  }
  .grow {
    flex: 1;
  }
  .show-m {
    display: none;
  }

  /* Scrolled (motion.md §3). */
  :global(html.scrolled) .nav {
    top: 8px;
  }
  :global(html.scrolled) .pill {
    height: 48px;
    padding: 4px;
    background: var(--k-surface-container);
  }
  :global(html.scrolled) .item,
  :global(html.scrolled) .ibtn {
    height: 36px;
  }
  :global(html.scrolled) .ibtn {
    width: 36px;
  }
  :global(html.scrolled) .fab {
    height: 48px;
  }

  /* Theme popover: placed under the button by site.ts. */
  .theme-pop {
    position: fixed;
    inset: auto;
    top: 80px;
    right: 16px;
    margin: 0;
    width: 304px;
    max-width: calc(100vw - 32px);
    max-height: calc(100dvh - 96px);
    overflow-y: auto;
    padding: 16px 12px 12px;
    border-radius: var(--k-r-l);
    background: var(--k-surface-container);
    border: 1px solid var(--k-outline-variant);
    color: var(--k-on-surface);
    transform-origin: top right;
  }
  .theme-pop:popover-open {
    animation: pop-in var(--k-dur-fast) var(--k-ease);
  }
  @keyframes pop-in {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }

  /* Mobile sheet. */
  .sheet {
    margin: auto 0 0;
    width: 100%;
    max-width: 100%;
    max-height: calc(100dvh - 32px);
    border: none;
    border-radius: 28px 28px 0 0;
    background: var(--k-surface-container-low);
    color: var(--k-on-surface);
    padding: 0 12px 24px;
  }
  .sheet[open] {
    animation: sheet-in var(--k-dur-sheet) var(--k-ease);
  }
  .sheet::backdrop {
    background: var(--k-scrim);
    animation: fade-in var(--k-dur-fast) var(--k-ease);
  }
  @keyframes sheet-in {
    from {
      transform: translateY(100%);
    }
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
  .handle {
    width: 32px;
    height: 4px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--k-on-surface-variant) 40%, transparent);
    margin: 10px auto;
  }
  .sheet-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 8px 12px 12px;
  }
  .sheet-links {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .sheet-item {
    height: 56px;
    padding: 0 16px;
    border-radius: var(--k-r-full);
    display: flex;
    align-items: center;
    gap: 16px;
    color: var(--k-on-surface);
    text-decoration: none;
  }
  .sheet-item :global(.ic) {
    color: var(--k-on-surface-variant);
  }
  .sheet-item.on {
    background: var(--k-secondary-container);
    color: var(--k-on-secondary-container);
  }
  .sheet-item.on :global(.ic) {
    color: var(--k-on-secondary-container);
  }
  .sheet-div {
    height: 1px;
    background: var(--k-outline-variant);
    margin: 12px 16px;
  }
  .sheet-more {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .sheet-more a {
    height: 48px;
    padding: 0 16px;
    border-radius: var(--k-r-full);
    display: flex;
    align-items: center;
    font: 400 16px/26px var(--k-font);
    color: var(--k-on-surface-variant);
    text-decoration: none;
  }
  .sheet-cta {
    width: calc(100% - 8px);
    margin: 12px 4px 0;
  }

  /* Tablet: no wordmark, icon-only FAB (open-decisions §12). */
  @media (max-width: 1023px) {
    .word {
      display: none;
    }
    .brand {
      padding: 0 4px;
    }
    .item {
      padding: 0 14px;
    }
    .fab {
      width: 56px;
      padding: 0;
      justify-content: center;
    }
    :global(html.scrolled) .fab {
      width: 48px;
    }
    .fab-label {
      display: none;
    }
  }

  /* Mobile: full-width pill, FAB fixed bottom right. */
  @media (max-width: 599px) {
    .nav {
      top: 12px;
    }
    .pill {
      width: 100%;
    }
    .hide-m {
      display: none;
    }
    .show-m {
      display: flex;
    }
    .word {
      display: inline;
    }
    .brand {
      padding: 0 14px 0 4px;
    }
    .fab {
      position: fixed;
      right: 16px;
      bottom: calc(16px + env(safe-area-inset-bottom));
      height: 56px;
      width: auto;
      padding: 0 22px 0 18px;
      justify-content: flex-start;
    }
    .fab-label {
      display: inline;
    }
    :global(html.scrolled) .fab {
      height: 56px;
      width: auto;
    }
    /* Extended on the Home hero only, icon-only everywhere else. */
    :global(html:not(.at-hero)) .fab {
      width: 56px;
      padding: 0 17px;
    }
    :global(html:not(.at-hero)) .fab-label {
      opacity: 0;
    }
    .theme-pop {
      top: 76px;
      right: 16px;
      width: auto;
      left: 16px;
      max-width: none;
    }
  }
</style>
