---
/**
 * The launch film as a click-to-load facade (video-embed.md §2–3). Until the
 * visitor presses play this is a button over a local poster: no iframe and no
 * request to YouTube. site.ts swaps in the youtube-nocookie player on click.
 * Chapter buttons elsewhere on the page ([data-yt-start]) drive this player.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { config } from '@/config';
import Icon from './Icon.astro';

interface Props {
  poster: ImageMetadata;
  /** Rendered width on wide screens, for the srcset `sizes`. */
  width: number;
}
const { poster, width } = Astro.props;
---
<div class="vp" data-yt={config.tourVideoId}>
  <button type="button" class="vp-btn" aria-label="Play the Kuber feature tour, 3 minutes">
    <Picture
      src={poster}
      widths={[640, 1280]}
      sizes={`(min-width: 1024px) ${width}px, 100vw`}
      formats={['avif', 'webp']}
      alt=""
      loading="lazy"
      decoding="async"
      class="vp-img"
    />
    <span class="vp-pill">
      <Icon name="play_arrow" fill size={26} class="vp-play" />
      <svg class="vp-spin" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-opacity=".32" stroke-width="2.5"></circle>
        <path d="M12 3a9 9 0 0 1 9 9" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path>
      </svg>
      <span class="vp-l">Play the tour</span>
      <span class="vp-load">Loading</span>
      <span class="vp-div"></span>
      <span class="vp-t">3:03</span>
    </span>
  </button>
  <!-- Filled by site.ts when the visitor is offline. -->
  <span class="vp-off" role="status"></span>
</div>

<style>
  .vp {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 24px;
    background: #000000;
    overflow: hidden;
  }
  .vp:has(.vp-btn:focus-visible) {
    outline: 3px solid var(--k-primary);
    outline-offset: 3px;
  }
  .vp-btn,
  .vp :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .vp-btn {
    z-index: 1;
    padding: 0;
    background: none;
    cursor: pointer;
    transition: opacity var(--k-dur-fast) var(--k-ease), visibility 0s var(--k-dur-fast);
  }
  .vp-btn:focus-visible {
    outline: none;
  }
  .vp-btn :global(picture),
  .vp-btn :global(.vp-img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (hover: hover) {
    .vp-btn:not(:disabled):hover::after {
      content: '';
      position: absolute;
      inset: 0;
      background: color-mix(in srgb, var(--k-on-surface) 8%, transparent);
    }
    .vp-btn:not(:disabled):hover .vp-pill {
      box-shadow: inset 0 0 0 999px color-mix(in srgb, var(--k-on-primary) 8%, transparent);
    }
  }
  .vp-pill,
  .vp-off {
    position: absolute;
    left: 24px;
    bottom: 24px;
    z-index: 2;
    min-height: 56px;
    border-radius: var(--k-r-full);
    display: flex;
    align-items: center;
    font: 600 16px/20px var(--k-font);
    letter-spacing: 0.1px;
  }
  .vp-pill {
    padding: 0 22px 0 18px;
    gap: 10px;
    background: var(--k-primary);
    color: var(--k-on-primary);
    white-space: nowrap;
    transition: box-shadow var(--k-dur-fast) var(--k-ease);
  }
  .vp-div {
    width: 1px;
    height: 20px;
    background: color-mix(in srgb, var(--k-on-primary) 40%, transparent);
  }
  .vp-t {
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .vp-spin {
    flex: none;
    animation: vp-spin 1.4s linear infinite;
  }
  @keyframes vp-spin {
    to {
      transform: rotate(1turn);
    }
  }
  .vp-spin,
  .vp-load,
  .vp[data-state='loading'] .vp-pill :global(.vp-play),
  .vp[data-state='loading'] .vp-l,
  .vp[data-state='loading'] .vp-div,
  .vp[data-state='loading'] .vp-t,
  .vp[data-state='offline'] .vp-pill {
    display: none;
  }
  .vp[data-state='loading'] .vp-spin,
  .vp[data-state='loading'] .vp-load {
    display: inline;
  }
  .vp[data-state='loading'] .vp-btn {
    cursor: progress;
  }
  .vp[data-state='playing'] .vp-btn {
    opacity: 0;
    visibility: hidden;
  }
  @media (prefers-reduced-motion: reduce) {
    .vp-btn {
      transition: none;
    }
  }
  .vp-off {
    right: 24px;
    width: fit-content;
    padding: 10px 22px;
    background: var(--k-inverse-surface);
    color: var(--k-inverse-on-surface);
  }
  .vp-off:empty {
    display: none;
  }
  @media (max-width: 599px) {
    .vp {
      border-radius: 20px;
    }
    .vp-pill,
    .vp-off {
      left: 12px;
      bottom: 12px;
      min-height: 48px;
      font-size: 15px;
    }
    .vp-pill {
      padding: 0 18px 0 14px;
    }
    .vp-off {
      right: 12px;
      padding: 8px 18px;
    }
    .vp-pill :global(.vp-play) {
      width: 24px;
      height: 24px;
    }
  }
</style>
