---
/** The one footer (Web v1 C9), on every page. "Last updated" is the build date. */
import { config } from '@/config';
import { url } from '@/lib/url';
import BrandMark from './BrandMark.astro';
import PlayBadge from './PlayBadge.astro';

const cols = [
  ['Product', [
    ['Features', url('/features')],
    ['Kuber Pro', url('/features/pro-plans')],
    // ['Changelog', url('/changelog')],
  ]],
  ['Help', [['Docs', url('/docs')], ['FAQ', url('/docs/faq')], ['Support', config.githubUrl]]],
  ['Legal', [['Privacy Policy', url('/docs/privacy-policy')], ['Data Deletion', url('/docs/data-deletion')]]],
  ['Kuber', [['About', url('/about')], ['Press kit', url('/press')], ['GitHub', config.githubUrl], ['Developer site', config.portfolioUrl]]],
] as const;
const now = new Date();
const built = now.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
const external = (href: string) => href.startsWith('http');
---
<footer class="footer">
  <div class="wrap">
    <div class="grid">
      <div class="brand-col">
        <a href={url('/')} class="brand" aria-label="Kuber home"><BrandMark size={32} /><span>Kuber</span></a>
        <p class="t-body-s muted">Fully offline personal finance. Your money, your device, your business.</p>
        <PlayBadge />
      </div>
      {cols.map(([head, items]) => (
        <div class="col">
          <h2 class="eyebrow muted">{head}</h2>
          {items.map(([label, href]) => (
            <a href={href} class="t-body-s" {...(external(href) ? { target: '_blank', rel: 'noopener' } : {})}>{label}</a>
          ))}
        </div>
      ))}
    </div>
    <div class="legal t-cap muted">
      <span>© {now.getFullYear()} Kuber</span>
      <span>Last updated {built}</span>
      <span>No cookies, analytics or trackers on this site</span>
      <span class="grow"></span>
      <span>Made in India</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--k-outline-variant);
    background: var(--k-surface);
    margin-top: auto;
  }
  .grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
    gap: 32px;
    padding: 64px 0 40px;
  }
  .brand-col {
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: flex-start;
  }
  .brand-col p {
    max-width: 300px;
    text-wrap: pretty;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 0;
    font: 700 17px/24px var(--k-font);
    letter-spacing: -0.2px;
    color: var(--k-on-surface);
    text-decoration: none;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }
  .col h2 {
    margin-bottom: 0;
  }
  .col a {
    color: var(--k-on-surface);
    text-decoration: none;
    width: max-content;
    max-width: 100%;
    padding: 2px 0;
  }
  .col a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    align-items: center;
    padding: 20px 0 32px;
    border-top: 1px solid var(--k-outline-variant);
  }
  .grow {
    flex: 1;
  }
  @media (max-width: 1023px) {
    .grid {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
    }
    .brand-col {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 599px) {
    .grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px 16px;
      padding: 48px 0 40px;
    }
    .legal {
      padding-bottom: 96px;
    }
  }
</style>
