---
/**
 * Static phone mock of the Transaction History tab, used in the theme showcase.
 * Live-recolors with the active theme. Traced from Homepage.dc.html.
 */
---
<div class="sp-frame">
  <div class="sp-screen">
    <div class="sp-status">
      <span>9:41</span>
      <span class="sp-status-icons">
        <svg width="14" height="10" viewBox="0 0 18 12" fill="currentColor"><rect x="0" y="8" width="3" height="4" rx="1"/><rect x="5" y="5" width="3" height="7" rx="1"/><rect x="10" y="2" width="3" height="10" rx="1"/><rect x="15" y="0" width="3" height="12" rx="1" opacity=".4"/></svg>
        <svg width="21" height="11" viewBox="0 0 26 13" fill="none"><rect x="1" y="1" width="21" height="11" rx="3" stroke="currentColor" stroke-width="1.2" opacity=".5"/><rect x="3" y="3" width="14" height="7" rx="1.5" fill="currentColor"/></svg>
      </span>
    </div>
    <div class="sp-appbar">
      <div class="sp-appbar-text"><div class="sp-title">Transaction<br/>History</div><div class="sp-subtitle">Your past expenses, incomes and transfers</div></div>
      <div class="sp-dl"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12M8 11l4 4 4-4M5 21h14"/></svg></div>
    </div>
    <div class="sp-filters">
      <span class="sp-filters-label">FILTERS</span>
      <div style="flex:1"></div>
      <div class="sp-chip">Exp</div>
      <div class="sp-chip">Inc</div>
      <div class="sp-chip sp-chip-sq"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4"/></svg></div>
      <div class="sp-chip sp-chip-sq"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M7 12h10M10 18h4"/></svg></div>
    </div>
    <div class="sp-summary">
      <div class="sp-summary-row">
        <span>EXP <span class="sp-ex">-₹1,25,544</span></span>
        <span>INC <span class="sp-in">+₹1,95,000</span></span>
        <span>NET <span class="sp-in">+₹69,456</span></span>
      </div>
      <div class="sp-count">SHOWING <span class="sp-count-n">155</span> TRANSACTIONS</div>
    </div>
    <div class="sp-list">
      <div class="sp-group"><span>TODAY</span><span class="sp-group-line"></span><span>−₹18,000</span></div>
      <div class="sp-tx">
        <div class="sp-tx-ic sp-tx-in"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-8 9 8v9a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z"/></svg></div>
        <div class="sp-tx-main"><div class="sp-tx-title">Rent Payment</div><div class="sp-tx-meta">Rent · Bank</div></div>
        <div class="sp-tx-amt"><div class="sp-tx-val">-₹18,000</div><div class="sp-tx-time">12:00 AM</div></div>
      </div>
      <div class="sp-group"><span>YESTERDAY</span><span class="sp-group-line"></span><span>−₹720</span></div>
      <div class="sp-tx">
        <div class="sp-tx-ic sp-tx-ex"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3v7a2 2 0 0 0 2 2h0V3M8 3v18M17 3c-1.5 0-2.5 2-2.5 5s1 4 2.5 4v9"/></svg></div>
        <div class="sp-tx-main"><div class="sp-tx-title">Lunch / Dinner</div><div class="sp-tx-meta">Dining · Cash</div><div class="sp-tag">#work</div></div>
        <div class="sp-tx-amt"><div class="sp-tx-val">-₹700</div><div class="sp-tx-time">9:37 AM</div></div>
      </div>
      <div class="sp-group"><span>FRI, 15 AUG</span><span class="sp-group-line"></span><span>−₹200</span></div>
      <div class="sp-tx">
        <div class="sp-tx-ic sp-tx-ex"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3v7a2 2 0 0 0 2 2h0V3M8 3v18M17 3c-1.5 0-2.5 2-2.5 5s1 4 2.5 4v9"/></svg></div>
        <div class="sp-tx-main"><div class="sp-tx-title">Tea/Coffee</div><div class="sp-tx-meta">Dining · Cash</div></div>
        <div class="sp-tx-amt"><div class="sp-tx-val">-₹20</div><div class="sp-tx-time">5:11 PM</div></div>
      </div>
    </div>
    <div class="sp-nav">
      <div class="sp-nav-bar">
        <div class="sp-nav-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-8 9 8v9a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z"/></svg><span>Home</span></div>
        <div class="sp-nav-item sp-nav-active"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h14v16l-2-1.5L15 20l-2-1.5L11 20 9 18.5 7 20 5 18.5z"/><path d="M9 9h6M9 13h5"/></svg><span>History</span></div>
        <div class="sp-nav-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V10M10 20V4M16 20v-8M22 20V8"/></svg><span>Analytics</span></div>
        <div class="sp-nav-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg><span>More</span></div>
      </div>
      <div class="sp-fab"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></div>
    </div>
  </div>
</div>

<style>
  .sp-frame { justify-self: center; width: 266px; padding: 10px; background: var(--k-bg); border: 1px solid var(--k-border-muted); border-radius: 40px; }
  .sp-screen { background: var(--k-bg); border: 1px solid var(--k-border); border-radius: 30px; height: 560px; overflow: hidden; display: flex; flex-direction: column; }
  .sp-status { display: flex; align-items: center; justify-content: space-between; padding: 9px 18px 2px; font: 700 10.5px var(--font-sans); color: var(--k-text); opacity: 0.28; flex-shrink: 0; }
  .sp-status-icons { display: flex; gap: 5px; align-items: center; }
  .sp-appbar { display: flex; align-items: flex-start; gap: 10px; padding: 8px 16px; flex-shrink: 0; }
  .sp-appbar-text { flex: 1; min-width: 0; }
  .sp-title { font: 800 23px var(--font-sans); letter-spacing: -0.7px; line-height: 1.08; color: var(--k-text); }
  .sp-subtitle { font: 400 11px var(--font-sans); color: var(--k-text-sec); margin-top: 6px; line-height: 1.35; }
  .sp-dl { width: 38px; height: 38px; border-radius: 999px; background: var(--k-accent); display: flex; align-items: center; justify-content: center; color: var(--k-on-accent); flex-shrink: 0; }
  .sp-filters { display: flex; align-items: center; gap: 6px; padding: 2px 16px 8px; flex-shrink: 0; }
  .sp-filters-label { font: 800 9px var(--font-sans); letter-spacing: 1px; color: color-mix(in srgb, var(--k-text-sec) 60%, transparent); }
  .sp-chip { height: 28px; padding: 0 9px; display: flex; align-items: center; background: var(--k-muted); border: 1px solid var(--k-border); border-radius: 8px; font: 800 11px var(--font-sans); letter-spacing: 0.3px; color: var(--k-text-sec); }
  .sp-chip-sq { width: 28px; padding: 0; justify-content: center; flex-shrink: 0; }
  .sp-summary { padding: 0 16px 8px; flex-shrink: 0; }
  .sp-summary-row { display: flex; gap: 8px; font: 700 9px var(--font-sans); white-space: nowrap; color: var(--k-text-sec); }
  .sp-ex { color: var(--k-expense); }
  .sp-in { color: var(--k-income); }
  .sp-count { font: 700 9.5px var(--font-sans); letter-spacing: 0.8px; color: var(--k-text-sec); margin-top: 7px; }
  .sp-count-n { color: var(--k-accent-text); }
  .sp-list { flex: 1; overflow-y: auto; padding: 0 16px 14px; display: flex; flex-direction: column; gap: 8px; }
  .sp-group { display: flex; align-items: center; gap: 8px; padding: 6px 0; font: 700 11px var(--font-sans); letter-spacing: 1px; color: var(--k-text-sec); }
  .sp-group-line { flex: 1; height: 0.5px; background: var(--k-border); }
  .sp-group span:last-child { font-weight: 600; font-size: 12px; }
  .sp-tx { background: var(--k-card); border: 1px solid var(--k-border); border-radius: 8px; padding: 11px 14px; display: flex; align-items: center; gap: 12px; }
  .sp-tx-ic { width: 40px; height: 40px; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .sp-tx-in { background: color-mix(in srgb, var(--k-income) 15%, var(--k-card)); color: var(--k-income); }
  .sp-tx-ex { background: color-mix(in srgb, var(--k-expense) 15%, var(--k-card)); color: var(--k-expense); }
  .sp-tx-main { flex: 1; min-width: 0; }
  .sp-tx-title { font: 600 14px var(--font-sans); color: var(--k-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sp-tx-meta { font: 400 11.5px var(--font-sans); color: var(--k-text-sec); }
  .sp-tag { font: 600 11px var(--font-sans); color: var(--k-accent-text); margin-top: 2px; }
  .sp-tx-amt { text-align: right; }
  .sp-tx-val { font: 700 14px var(--font-sans); color: var(--k-text); }
  .sp-tx-time { font: 400 10.5px var(--font-sans); color: var(--k-text-sec); margin-top: 1px; }
  .sp-nav { flex-shrink: 0; padding: 7px 12px 13px; display: flex; align-items: center; gap: 8px; }
  .sp-nav-bar { flex: 1; display: flex; align-items: center; justify-content: space-between; background: var(--k-card); border: 1px solid var(--k-border); border-radius: 18px; padding: 8px 14px; }
  .sp-nav-item { display: flex; flex-direction: column; align-items: center; gap: 3px; color: var(--k-text-sec); font: 500 8px var(--font-sans); }
  .sp-nav-active { color: var(--k-accent-text); font-weight: 700; }
  .sp-fab { width: 46px; height: 46px; border-radius: 16px; background: var(--k-accent); color: var(--k-on-accent); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
</style>
