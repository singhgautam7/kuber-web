---
/**
 * "Get it on Google Play" badge, reproduced as inline SVG + text per the design
 * (the design draws the mark inline rather than loading Google's PNG). Links to
 * config.playStoreUrl.
 */
import { config } from '@/config';
interface Props {
  size?: 'md' | 'lg';
}
const { size = 'md' } = Astro.props;
const pad = size === 'lg' ? '11px 20px' : '10px 18px';
---
<a
  href={config.playStoreUrl}
  target="_blank"
  rel="noopener"
  class="play-badge"
  style={`padding:${pad}`}
>
  <svg width="22" height="24" viewBox="0 0 40 44" aria-hidden="true">
    <path fill="#34A853" d="M3 3 3 22 15 22Z"></path>
    <path fill="#4285F4" d="M3 41 3 22 15 22Z"></path>
    <path fill="#EA4335" d="M3 3 15 22 37 22Z"></path>
    <path fill="#FBBC04" d="M3 41 15 22 37 22Z"></path>
  </svg>
  <span class="play-badge-text">
    <span class="play-badge-small">Get it on</span>
    <span class="play-badge-big">Google Play</span>
  </span>
</a>

<style>
  .play-badge {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: #000;
    border: 1px solid #3f3f46;
    border-radius: 11px;
    color: #fff;
  }
  .play-badge:hover {
    opacity: 0.9;
  }
  .play-badge-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  .play-badge-small {
    font: 500 9px var(--font-sans);
    letter-spacing: 0.6px;
    color: #fff;
    text-transform: uppercase;
  }
  .play-badge-big {
    font: 600 19px var(--font-sans);
    color: #fff;
    margin-top: 2px;
  }
</style>
