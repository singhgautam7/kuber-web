---
/**
 * Copy-to-clipboard button (text style, Web v1 Press). site.ts copies
 * data-copy, swaps the label to "Copied" and the icon to a check for 2s;
 * the live region announces it.
 */
import Icon from './Icon.astro';
interface Props {
  text: string;
  label?: string;
  kind?: 'text' | 'tonal';
  attrs?: Record<string, string>;
}
const { text, label = 'Copy text', kind = 'text', attrs = {} } = Astro.props;
---
<button type="button" class:list={['btn btn-s has-icon sl copy', `btn-${kind}`]} data-copy={text} {...attrs}>
  <Icon name="content_copy" size={18} class="c-idle" />
  <Icon name="check" size={18} class="c-done" />
  <span data-copy-label aria-live="polite">{label}</span>
</button>

<style>
  .copy :global(.c-done),
  .copy[data-copied] :global(.c-idle) {
    display: none;
  }
  .copy[data-copied] :global(.c-done) {
    display: inline-block;
  }
  .copy[data-copied] {
    background: var(--k-secondary-container);
    color: var(--k-on-secondary-container);
  }
</style>
