---
/**
 * Static phone mock of the Home tab, used in the hero. Pure token-driven markup
 * traced from Homepage.dc.html (no images, so it recolors with the theme).
 */
---
<div class="hero-phone-wrap">
  <div class="hero-phone-glow"></div>
  <div class="hero-phone">
    <div class="hero-screen">
      <!-- status bar -->
      <div class="hp-status">
        <span>9:41</span>
        <span class="hp-status-icons">
          <svg width="15" height="11" viewBox="0 0 18 12" fill="currentColor"><rect x="0" y="8" width="3" height="4" rx="1"/><rect x="5" y="5" width="3" height="7" rx="1"/><rect x="10" y="2" width="3" height="10" rx="1"/><rect x="15" y="0" width="3" height="12" rx="1" opacity=".4"/></svg>
          <svg width="15" height="12" viewBox="0 0 20 15" fill="currentColor"><path d="M10 3.5c2.9 0 5.5 1.1 7.4 3l1.6-1.6A13 13 0 0 0 10 .9 13 13 0 0 0 1 4.9L2.6 6.5A10 10 0 0 1 10 3.5zM10 8c1.5 0 2.9.6 3.9 1.6l1.6-1.6A8 8 0 0 0 10 5.5 8 8 0 0 0 4.5 8l1.6 1.6A5.5 5.5 0 0 1 10 8zm0 3.5l2.5 2.5-2.5 1z"/></svg>
          <svg width="22" height="12" viewBox="0 0 26 13" fill="none"><rect x="1" y="1" width="21" height="11" rx="3" stroke="currentColor" stroke-width="1.2" opacity=".5"/><rect x="3" y="3" width="14" height="7" rx="1.5" fill="currentColor"/><rect x="23.5" y="4" width="2" height="5" rx="1" fill="currentColor" opacity=".5"/></svg>
        </span>
      </div>
      <!-- scroll area -->
      <div class="hp-scroll">
        <div class="hp-topbar">
          <div class="hp-pro"><span class="hp-pro-dot"><svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 4.9 5.4.8-3.9 3.8.9 5.3L12 14.9 7.2 17l.9-5.3L4.2 7.9l5.4-.8z"/></svg></span><span>Kuber Pro</span></div>
          <div style="flex:1"></div>
          <div class="hp-icon-btn"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z"/><circle cx="12" cy="12" r="3"/></svg></div>
          <div class="hp-icon-btn hp-bell"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9a6 6 0 0 1 12 0c0 7 3 8 3 8H3s3-1 3-8M10 21h4"/></svg><span class="hp-badge">3</span></div>
        </div>
        <div>
          <div class="hp-greeting">Evening, Gautam</div>
          <div class="hp-sub">Stay on top of your finances</div>
        </div>
        <div class="hp-card">
          <div class="hp-net-row"><span class="hp-net-label">JULY · NET</span><span class="hp-net-value">+₹45,200</span></div>
          <div class="hp-bar"><div class="hp-bar-in"></div><div class="hp-bar-ex"></div></div>
          <div class="hp-net-legend"><span class="hp-legend"><span class="hp-dot hp-dot-in"></span><span class="hp-legend-v">₹65,000</span></span><span class="hp-legend"><span class="hp-legend-v">₹19,800</span><span class="hp-dot hp-dot-ex"></span></span></div>
        </div>
        <div>
          <div class="hp-section-label">MONEY STORIES</div>
          <div class="hp-stories scroll-x">
            {[
              { name: 'Daily', c: '#3B82F6', dash: '43.2 5', icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M3 10h18M8 2v4M16 2v4"/></svg>' },
              { name: 'Weekly', c: '#22C55E', dash: '43.2 5', icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V10M10 20V4M16 20v-8M22 20V8"/></svg>' },
              { name: 'Monthly', c: '#F59E0B', dash: '43.2 5', icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M3 10h18M8 2v4M16 2v4"/></svg>' },
              { name: 'Insights', c: '#7C6FF0', dash: '23.9 5', icon: '<svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3l2 5 5 2-5 2-2 5-2-5-5-2 5-2z"/></svg>' },
              { name: 'Yearly', c: '#EAB308', dash: '43.2 5', icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 10 10h-10z"/><path d="M12 2v10h10A10 10 0 0 0 12 2z" opacity=".4"/></svg>' },
            ].map((s) => (
              <div class="hp-story">
                <div class="hp-ring">
                  <svg width="50" height="50" viewBox="0 0 50 50"><circle cx="25" cy="25" r="23" fill="none" stroke={s.c} stroke-width="2.5" stroke-linecap="round" stroke-dasharray={s.dash} transform="rotate(-90 25 25)"/></svg>
                  <div class="hp-ring-inner" style={`background:color-mix(in srgb,${s.c} 16%,var(--k-muted));color:${s.c}`} set:html={s.icon}></div>
                </div>
                <div class="hp-story-name">{s.name}</div>
              </div>
            ))}
          </div>
        </div>
        <div>
          <div class="hp-qa-head"><span class="hp-section-label">QUICK ADD</span><span class="hp-qa-full">FULL SCREEN</span></div>
          <div class="hp-qa-row">
            <div class="hp-qa-input">e.g. 250 on groceries</div>
            <div class="hp-qa-btn"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10a7 7 0 0 0 14 0M12 19v3"/></svg></div>
            <div class="hp-qa-btn"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4Z"/></svg></div>
          </div>
        </div>
        <div>
          <div class="hp-section-label">SPENDING PATTERN</div>
          <div class="hp-pattern">
            <div class="hp-pat-cell" style="border-right:1px solid var(--k-border)"><div class="hp-pat-k">AVG DAILY</div><div class="hp-pat-v">₹1,389</div></div>
            <div class="hp-pat-cell" style="border-right:1px solid var(--k-border)"><div class="hp-pat-k">THIS MONTH</div><div class="hp-pat-v">₹19,800</div></div>
            <div class="hp-pat-cell"><div class="hp-pat-k">PROJECTED</div><div class="hp-pat-v">₹43,071</div></div>
          </div>
        </div>
      </div>
      <!-- bottom nav -->
      <div class="hp-nav">
        <div class="hp-nav-bar">
          <div class="hp-nav-item hp-nav-active"><svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor"><path d="M3 11l9-8 9 8v9a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z"/></svg><span>Home</span></div>
          <div class="hp-nav-item"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h14v16l-2-1.5L15 20l-2-1.5L11 20 9 18.5 7 20 5 18.5z"/><path d="M9 8h6M9 12h6"/></svg><span>History</span></div>
          <div class="hp-nav-item"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V10M10 20V4M16 20v-8M22 20V8"/></svg><span>Analytics</span></div>
          <div class="hp-nav-item"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg><span>More</span></div>
        </div>
        <div class="hp-fab"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></div>
      </div>
    </div>
  </div>
</div>

<style>
  .hero-phone-wrap {
    justify-self: center;
    position: relative;
  }
  .hero-phone-glow {
    position: absolute;
    inset: -8% -6%;
    background: radial-gradient(60% 55% at 50% 42%, var(--k-accent-subtle), transparent 70%);
    border-radius: 50%;
  }
  .hero-phone {
    position: relative;
    width: 288px;
    padding: 11px;
    background: var(--k-card);
    border: 1px solid var(--k-border-muted);
    border-radius: 44px;
  }
  .hero-screen {
    border-radius: 34px;
    overflow: hidden;
    border: 1px solid var(--k-border);
    background: var(--k-bg);
    height: 568px;
    display: flex;
    flex-direction: column;
  }
  .hp-status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 9px 20px 2px;
    font: 700 11px var(--font-sans);
    color: var(--k-text);
    opacity: 0.28;
    flex-shrink: 0;
  }
  .hp-status-icons { display: flex; gap: 5px; align-items: center; color: var(--k-text); }
  .hp-scroll { flex: 1; overflow-y: auto; padding: 8px 14px 12px; display: flex; flex-direction: column; gap: 15px; }
  .hp-topbar { display: flex; align-items: center; gap: 8px; }
  .hp-pro { display: flex; align-items: center; gap: 6px; background: var(--k-muted); border: 1px solid var(--k-accent-ring); border-radius: 8px; padding: 6px 9px; font: 700 11px var(--font-sans); color: var(--k-text); }
  .hp-pro-dot { width: 17px; height: 17px; border-radius: 999px; background: var(--k-accent-subtle); display: flex; align-items: center; justify-content: center; color: var(--k-accent-text); }
  .hp-icon-btn { position: relative; background: var(--k-muted); border: 1px solid var(--k-border); border-radius: 8px; padding: 7px; color: var(--k-text-sec); display: flex; }
  .hp-badge { position: absolute; top: -5px; right: -5px; min-width: 15px; height: 15px; background: var(--k-expense); border: 2px solid var(--k-bg); border-radius: 999px; color: #fff; font: 800 8px var(--font-sans); display: flex; align-items: center; justify-content: center; padding: 0 2px; }
  .hp-greeting { font: 800 24px var(--font-sans); letter-spacing: -0.6px; color: var(--k-text); }
  .hp-sub { font: 400 12.5px var(--font-sans); color: var(--k-text-sec); margin-top: 2px; }
  .hp-card { background: var(--k-card); border: 1px solid var(--k-border); border-radius: 10px; padding: 14px; }
  .hp-net-row { display: flex; justify-content: space-between; align-items: baseline; }
  .hp-net-label { font: 700 10px var(--font-sans); letter-spacing: 1px; color: var(--k-text-sec); }
  .hp-net-value { font: 800 21px var(--font-sans); letter-spacing: -0.5px; color: var(--k-income); }
  .hp-bar { display: flex; gap: 4px; margin-top: 13px; }
  .hp-bar-in { flex: 3.3; height: 8px; border-radius: 999px; background: var(--k-income); }
  .hp-bar-ex { flex: 1; height: 8px; border-radius: 999px; background: var(--k-expense); }
  .hp-net-legend { display: flex; justify-content: space-between; margin-top: 10px; }
  .hp-legend { display: flex; align-items: center; gap: 6px; }
  .hp-legend-v { font: 700 12px var(--font-sans); color: var(--k-text); }
  .hp-dot { width: 7px; height: 7px; border-radius: 999px; }
  .hp-dot-in { background: var(--k-income); }
  .hp-dot-ex { background: var(--k-expense); }
  .hp-section-label { font: 700 10px var(--font-sans); letter-spacing: 1px; color: var(--k-text-sec); margin-bottom: 12px; }
  .hp-stories { display: flex; gap: 14px; padding-bottom: 2px; }
  .hp-story { text-align: center; flex: 0 0 auto; width: 56px; }
  .hp-ring { position: relative; width: 50px; height: 50px; margin: 0 auto; }
  .hp-ring svg { position: absolute; inset: 0; }
  .hp-ring-inner { position: absolute; inset: 5px; border-radius: 999px; display: flex; align-items: center; justify-content: center; }
  .hp-story-name { font: 600 10.5px var(--font-sans); color: var(--k-text); margin-top: 7px; }
  .hp-qa-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
  .hp-qa-head .hp-section-label { margin-bottom: 0; }
  .hp-qa-full { font: 700 9.5px var(--font-sans); letter-spacing: 1px; color: var(--k-accent-text); }
  .hp-qa-row { display: flex; gap: 8px; align-items: stretch; }
  .hp-qa-input { flex: 1; background: var(--k-card); border: 1px solid var(--k-border); border-radius: 8px; padding: 0 11px; display: flex; align-items: center; font: 400 12px var(--font-sans); color: var(--k-text-sec); }
  .hp-qa-btn { width: 42px; height: 40px; border-radius: 8px; background: var(--k-accent); display: flex; align-items: center; justify-content: center; color: var(--k-on-accent); }
  .hp-pattern { background: var(--k-card); border: 1px solid var(--k-border); border-radius: 10px; padding: 13px; display: flex; }
  .hp-pat-cell { flex: 1; text-align: center; }
  .hp-pat-k { font: 700 9px var(--font-sans); letter-spacing: 0.5px; color: var(--k-text-sec); }
  .hp-pat-v { font: 700 15px var(--font-sans); color: var(--k-text); margin-top: 3px; }
  .hp-nav { flex-shrink: 0; padding: 8px 12px 14px; display: flex; align-items: center; gap: 8px; }
  .hp-nav-bar { flex: 1; display: flex; align-items: center; justify-content: space-between; background: var(--k-card); border: 1px solid var(--k-border); border-radius: 18px; padding: 9px 14px; }
  .hp-nav-item { display: flex; flex-direction: column; align-items: center; gap: 3px; color: var(--k-text-sec); font: 500 9px var(--font-sans); }
  .hp-nav-active { color: var(--k-accent-text); font-weight: 700; }
  .hp-fab { width: 48px; height: 48px; border-radius: 16px; background: var(--k-accent); color: var(--k-on-accent); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
</style>
