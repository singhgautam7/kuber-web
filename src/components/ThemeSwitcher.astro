---
/**
 * Theme switcher: a pill button that opens a dropdown with a light/dark toggle
 * and the 7 accent families. Active states are pure CSS (keyed off the html
 * attributes); src/scripts/site.ts handles open/close, apply, and persistence.
 *
 * Each family swatch carries its dark + light accent as CSS vars so the swatch
 * recolors with the mode without JS.
 */
import { THEMES, PALETTES } from '@/lib/theme';
interface Props {
  id?: string;
}
const { id = 'theme-menu' } = Astro.props;
---
<div class="theme-dd">
  <button
    type="button"
    class="theme-pill"
    data-theme-toggle
    aria-controls={id}
    aria-expanded="false"
    aria-haspopup="menu"
  >
    <span class="theme-swatch" aria-hidden="true"></span>
    <span class="visually-hidden">Theme:</span>
    <span class="theme-current" data-theme-name data-ddname>Kuber Signature</span>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
  </button>

  <div class="theme-menu" id={id} data-theme-menu role="menu" hidden>
    <div class="theme-modes">
      <button type="button" class="mode-btn" data-set-mode="light">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5L19 19M19 5l-1.5 1.5M6.5 17.5L5 19"></path></svg>
        Light
      </button>
      <button type="button" class="mode-btn" data-set-mode="dark">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg>
        Dark
      </button>
    </div>
    <div class="theme-sep"></div>
    {THEMES.map((t) => (
      <button
        type="button"
        class="theme-row"
        data-set-variant={t.id}
        role="menuitemradio"
        style={`--sw-dark:${PALETTES[t.id].dark.accent};--sw-light:${PALETTES[t.id].light.accent}`}
      >
        <span class="theme-row-swatch" aria-hidden="true"></span>
        <span class="theme-row-name">{t.name}</span>
        <span class="theme-row-label">{t.label}</span>
      </button>
    ))}
  </div>
</div>

<style>
  .theme-dd {
    position: relative;
  }
  .theme-pill {
    display: flex;
    align-items: center;
    gap: 9px;
    background: var(--k-muted);
    border: 1px solid var(--k-border);
    border-radius: 999px;
    padding: 6px 11px 6px 9px;
    color: var(--k-text);
  }
  .theme-swatch {
    width: 16px;
    height: 16px;
    border-radius: 999px;
    background: var(--k-accent);
    border: 1px solid var(--k-border-muted);
  }
  .theme-current {
    font: 600 13px var(--font-sans);
  }
  .theme-menu {
    position: absolute;
    top: 46px;
    right: 0;
    z-index: 70;
    width: 236px;
    background: var(--k-card);
    border: 1px solid var(--k-border);
    border-radius: 14px;
    padding: 8px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.28);
  }
  .theme-modes {
    display: flex;
    gap: 6px;
    margin-bottom: 6px;
  }
  .mode-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font: 600 12px var(--font-sans);
    padding: 8px 6px;
    border-radius: 9px;
    color: var(--k-text-sec);
    background: transparent;
    border: 1px solid var(--k-border);
  }
  .theme-sep {
    height: 1px;
    background: var(--k-border);
    margin: 0 2px 6px;
  }
  .theme-row {
    display: flex;
    align-items: center;
    gap: 11px;
    width: 100%;
    padding: 9px 10px;
    border-radius: 9px;
    border: 1px solid transparent;
    background: transparent;
    text-align: left;
  }
  .theme-row:hover {
    background: var(--k-muted);
  }
  .theme-row-swatch {
    width: 16px;
    height: 16px;
    border-radius: 999px;
    background: var(--sw-dark);
    flex-shrink: 0;
  }
  :global(:root[data-mode='light']) .theme-row-swatch {
    background: var(--sw-light);
  }
  .theme-row-name {
    flex: 1;
    font: 600 13.5px var(--font-sans);
    color: var(--k-text);
  }
  .theme-row-label {
    font: 500 11px var(--font-sans);
    color: var(--k-text-sec);
  }

  /* On narrow screens hide the name visually but keep it for assistive tech,
     so the button always has an accessible name that matches its visible text. */
  @media (max-width: 520px) {
    [data-ddname] {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }
</style>
