---
/**
 * Device frame for live mockups: 376 × 796 at 1x (mockup-map.md), bezel and
 * radius from the design, scaled by `--s` (set per breakpoint by the parent).
 * role="img" with a label: the screen inside is decorative for screen readers.
 */
interface Props {
  label: string;
  class?: string;
}
const { label, class: className } = Astro.props;
---
<div class:list={['phone', className]} role="img" aria-label={label}>
  <div class="bezel"><div class="screen"><slot /></div></div>
</div>

<style>
  /* --s is inherited from the page so it can change per breakpoint. */
  .phone {
    width: calc(376px * var(--s, 1));
    height: calc(796px * var(--s, 1));
    flex: none;
    position: relative;
  }
  .bezel {
    width: 376px;
    height: 796px;
    transform: scale(var(--s, 1));
    transform-origin: 0 0;
    border-radius: 40px;
    padding: 8px;
    background: var(--k-device);
  }
  .screen {
    height: 780px;
    border-radius: 32px;
    overflow: hidden;
    background: var(--k-surface);
    position: relative;
    display: flex;
    flex-direction: column;
    font-family: var(--k-font);
    line-height: normal;
  }
</style>
