---
/**
 * The Kuber app icon (design icon/icon.md, "folded leg" ₹): fixed brand colours
 * per mode, never per accent family. `bg`/`ink`/`leg` override them, as in the
 * final call-to-action panel.
 */
interface Props {
  size?: number;
  bg?: string;
  ink?: string;
  leg?: string;
}
const { size = 32, bg = 'var(--k-icon-bg)', ink = 'var(--k-icon-ink)', leg = 'var(--k-icon-leg)' } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 108 108" aria-hidden="true" focusable="false" style="flex:none">
  <rect width="108" height="108" rx="54" style={`fill:${bg}`}></rect>
  <g style={`fill:none;stroke:${ink};stroke-width:8.5;stroke-linecap:round;stroke-linejoin:round`}>
    <path d="M40.4 32.75H67.6"></path>
    <path d="M50.6 32.75A12.75 12.75 0 0 1 50.6 58.25H42.1"></path>
    <path d="M40.4 45.5H67.6"></path>
  </g>
  <path d="M42.1 58.25L61.65 74.4" style={`fill:none;stroke:${leg};stroke-width:8.5;stroke-linecap:round`}></path>
</svg>
