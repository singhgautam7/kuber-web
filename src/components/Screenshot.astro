---
/**
 * Screenshot with optional phone frame and theme-variant swap.
 *
 * Pass either a discovered `shot` (from getFeatureShots) or a raw `src`.
 * When both obsidian (dark) and alabaster (light) variants exist, both are
 * rendered and CSS shows the one matching the site mode; with a single image it
 * is used for both. Rendered via Astro's <Image> component with Sharp optimization,
 * 2x retina density, and lazy loading.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { asset } from '@/lib/url';
import type { Shot } from '@/lib/screenshots';
import PhoneFrame from './PhoneFrame.astro';

interface Props {
  shot?: Shot;
  src?: ImageMetadata | string;
  alt: string;
  frame?: 'phone' | 'none';
  width?: number;
  eager?: boolean;
}
const { shot, src, alt, frame = 'phone', width = 238, eager = false } = Astro.props;

const loading = eager ? 'eager' : 'lazy';
const fetchpriority = eager ? 'high' : undefined;
const dark = shot?.obsidian ?? shot?.single ?? src ?? null;
const light = shot?.alabaster ?? shot?.single ?? src ?? null;
const hasVariants = !!(shot?.obsidian && shot?.alabaster);

function isMeta(val: unknown): val is ImageMetadata {
  return typeof val === 'object' && val !== null && 'src' in val && 'width' in val;
}
---
{frame === 'phone' ? (
  <PhoneFrame width={width}>
    <Fragment>
      {hasVariants ? (
        <>
          {isMeta(dark) ? (
            <Image
              class="shot shot-dark"
              src={dark}
              alt={alt}
              width={width}
              densities={[1, 2]}
              loading={loading}
              decoding="async"
              fetchpriority={fetchpriority}
            />
          ) : (
            <img class="shot shot-dark" src={asset(dark! as string)} alt={alt} loading={loading} decoding="async" />
          )}
          {isMeta(light) ? (
            <Image
              class="shot shot-light"
              src={light}
              alt={alt}
              width={width}
              densities={[1, 2]}
              loading={loading}
              decoding="async"
              fetchpriority={fetchpriority}
            />
          ) : (
            <img class="shot shot-light" src={asset(light! as string)} alt={alt} loading={loading} decoding="async" />
          )}
        </>
      ) : isMeta(dark ?? light) ? (
        <Image
          class="shot"
          src={(dark ?? light)! as ImageMetadata}
          alt={alt}
          width={width}
          densities={[1, 2]}
          loading={loading}
          decoding="async"
          fetchpriority={fetchpriority}
        />
      ) : (
        <img class="shot" src={asset((dark ?? light ?? '') as string)} alt={alt} loading={loading} decoding="async" />
      )}
    </Fragment>
  </PhoneFrame>
) : hasVariants ? (
  <>
    {isMeta(dark) ? (
      <Image
        class="shot shot-dark shot-raw"
        src={dark}
        alt={alt}
        width={width}
        densities={[1, 2]}
        loading={loading}
        decoding="async"
        fetchpriority={fetchpriority}
      />
    ) : (
      <img class="shot shot-dark shot-raw" src={asset(dark! as string)} alt={alt} loading={loading} decoding="async" />
    )}
    {isMeta(light) ? (
      <Image
        class="shot shot-light shot-raw"
        src={light}
        alt={alt}
        width={width}
        densities={[1, 2]}
        loading={loading}
        decoding="async"
        fetchpriority={fetchpriority}
      />
    ) : (
      <img class="shot shot-light shot-raw" src={asset(light! as string)} alt={alt} loading={loading} decoding="async" />
    )}
  </>
) : isMeta(dark ?? light) ? (
  <Image
    class="shot shot-raw"
    src={(dark ?? light)! as ImageMetadata}
    alt={alt}
    width={width}
    densities={[1, 2]}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
  />
) : (
  <img class="shot shot-raw" src={asset((dark ?? light ?? '') as string)} alt={alt} loading={loading} decoding="async" />
)}

<style>
  .shot {
    display: block;
    width: 100%;
    height: auto;
  }
  .shot-raw {
    border-radius: 16px;
  }
  /* Variant swap driven by the site mode on <html>. */
  .shot-light {
    display: none;
  }
  :global(:root[data-mode='light']) .shot-dark {
    display: none;
  }
  :global(:root[data-mode='light']) .shot-light {
    display: block;
  }
</style>
