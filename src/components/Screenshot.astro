---
/**
 * One app screenshot as AVIF/WebP at 1x and 2x of `width`. With a dark
 * variant, both are rendered at the same size and CSS on html[data-mode]
 * shows one: no layout shift, and no flash because the attribute is set
 * before first paint. Lazy-loaded unless `eager`.
 * Corners follow the hero phone (40px on 376px wide), scaled to the rendered
 * width. class="crop" squares the bottom corners for cropped previews.
 */
import { Picture } from 'astro:assets';
import type { Shot } from '@/lib/screenshots';

interface Props {
  shot: Shot;
  width: number;
  eager?: boolean;
  alt?: string;
  class?: string;
}
const { shot, width, eager = false, alt = shot.alt, class: className } = Astro.props;
const common = {
  alt,
  width,
  densities: [1, 2],
  formats: ['avif', 'webp'] as ('avif' | 'webp')[],
  loading: eager ? ('eager' as const) : ('lazy' as const),
  decoding: 'async' as const,
  fetchpriority: eager ? ('high' as const) : undefined,
};
---
<span class:list={['shot', { 'has-dark': shot.dark }, className]}>
  <Picture src={shot.light} class="shot-img shot-l" {...common} />
  {shot.dark && <Picture src={shot.dark} class="shot-img shot-d" {...common} />}
</span>

<style>
  .shot {
    display: block;
    container-type: inline-size;
  }
  .shot :global(.shot-img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: calc(100cqw * 40 / 376);
    outline: 1px solid var(--k-outline-variant);
    outline-offset: -1px;
    background: var(--k-surface-container);
  }
  .shot.crop :global(.shot-img) {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }
  .shot :global(picture) {
    display: block;
  }
  .shot :global(picture:has(.shot-d)) {
    display: none;
  }
  :global(:root[data-mode='dark']) .has-dark :global(picture:has(.shot-l)) {
    display: none;
  }
  :global(:root[data-mode='dark']) .has-dark :global(picture:has(.shot-d)) {
    display: block;
  }
</style>
