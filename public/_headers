# Cloudflare Pages headers. Files in public/ are copied verbatim into dist/,
# so this ships at the site root. The most specific matching rule wins.

# Hashed, content-addressed build assets (JS/CSS/fonts under /_astro/) never
# change for a given URL, so cache them hard.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Everything else: short HTML cache + baseline security headers.
# NOTE: /assets/* (bank logos, app icon) are unhashed and intentionally fall
# under this shorter cache, not the immutable one above.
/*
  Cache-Control: public, max-age=3600
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()
